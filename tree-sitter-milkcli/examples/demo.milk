#!/usr/bin/env milk-script
#
# Example milk script demonstrating syntax
# highlighting with tree-sitter
#
# This script shows all major language constructs
# that the grammar recognizes.

# ---- Variable assignment ----
LOOPNAME="dmcomb-00"
DMINDEX=0
NBMODES=100
GAIN=0.3

# ---- Entity paths: @<namespace>.<name>.<property> ----
XSIZE=@s.dm${DMINDEX}disp.xsize
YSIZE=@stream.dm${DMINDEX}disp.ysize
FRAMECNT=@s.wfs.cnt0
CURGAIN=@f.${LOOPNAME}.gain
LOOPSTAT=@p.${LOOPNAME}.status
SEQSTEP=@q.mysequence.active_step
echo "frame @s.wfs.cnt0 of @s.wfs.xsize x @s.wfs.ysize"
echo "escaped: \@s.wfs.xsize"

# ---- milk commands: module.command or @command ----
mem.mk2Dim dm0ref 128 128
@mk2Dim "@L:buf" 64 64
@listim
@cmd? mem.listim
@?

# ---- Reading and writing entities ----
@get -v nx s.wfs.xsize
@get -A sizes 's.dm*.xsize'
@set f.${LOOPNAME}.gain=0.25
@set f.${LOOPNAME}.gain = 0.25
@set s.wfs.kw.OBS=night "comment"
@f.${LOOPNAME}.runstart
@exists s.wfs && echo "wfs exists"

# ---- Calculator ----
@calc "dm0ref = dm0ref * 0 + 5"
@calc -v m "imean(dm0ref)"
@ x = 2 * 21
echo "mean=@{imean(dm0ref)}"
HALF=@{${NBMODES} / 2}
@dpdigits 6
@batch "mem.mk2Dim a 64 64; a = 5; a *= 2"
@pipe "mem.mk2Dim p 32 32 |> _ = 4 |> _ *= 2.5"

# ---- Arithmetic ----
NUMPIX=$(( XSIZE * YSIZE ))

# ---- Conditional flow control ----
if [ "$LOOPSTAT" = "RUNNING" ]; then
    echo "Loop is running"
    echo "Current gain: $CURGAIN"
elif @test "imean(dm0ref) > 1"; then
    echo "bright"
else
    echo "Unknown state: $LOOPSTAT"
fi

# ---- Assertions ----
@assert "irms(dm0ref) < 0.5" "residual diverged"

# ---- For loop ----
for mode in $(seq 0 $NBMODES); do
    echo "Processing mode $mode"
done

# ---- While loop ----
CNT=0
while [[ $CNT -lt 10 && -n "$GAIN" ]]; do
    CNT=$(( CNT + 1 ))
done

# ---- Until loop ----
until [ $CNT -ge 20 ]; do
    CNT=$(( CNT + 1 ))
done

# ---- Case statement ----
case $LOOPSTAT in
    STOPPED)
        echo "stopped"
        ;;
    RUN | RUNNING)
        echo "running"
        ;;
    *)
        echo "unknown"
        ;;
esac

# ---- Function definitions ----
function set_loop_gain {
    local lname=$1
    local gval=$2
    @set f.${lname}.gain="$gval"
    echo "Set gain to $gval"
}

wait_frames() {
    @waitfor s.wfs "$1" -t 2 || { echo "no frames"; return 1; }
}

# ---- Waiting and events ----
@waitfor s.wfs 10 -t 2
@waitfor f.${LOOPNAME}.status=RUN -t 5
@waitany s.wfs s.dm0disp -t 1
@on --once --max-hz 10 s.wfs -- echo "new frame"
@defer rm -f /tmp/work.fits
milksleep 0.05

# ---- Stream pipe operator ----
mem.mk2Dim tmp 32 32 |> iofits.saveFITS _ ./tmp.fits

# ---- Source another script ----
source ./common_setup.milk
include_once ./hardware_init.milk

# ---- Export and declare ----
export MILK_SHM_DIR="/dev/shm"
readonly PI=3.14159
declare -i COUNTER=0

# ---- Traps ----
trap 'echo cleanup' EXIT

# ---- Pipeline with external commands ----
mem.listim | grep "dm" | wc -l

# ---- Redirection ----
echo "log entry" >> ./logfile.txt
iofits.saveFITS dm0ref ./dm0ref.fits > /dev/null 2>&1

# ---- Background execution ----
@grab s.wfs 100 "@L:cube" &

# ---- Logical operators ----
[ -f ./config.txt ] && source ./config.txt
[ -z "$GAIN" ] || echo "GAIN is set"
! @running f.${LOOPNAME} && @f.${LOOPNAME}.runstart

echo "Script complete" # trailing comment
exit 0
