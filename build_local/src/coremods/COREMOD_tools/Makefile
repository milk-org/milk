# target to preprocess a source file
stringutils.c.i:
	cd /home/oguyon/src/milk/build_local && $(MAKE) $(MAKESILENT) -f src/coremods/COREMOD_tools/CMakeFiles/milkCOREMODtools.dir/build.make src/coremods/COREMOD_tools/CMakeFiles/milkCOREMODtools.dir/stringutils.c.i
	cd /home/oguyon/src/milk/build_local && $(MAKE) $(MAKESILENT) -f src/coremods/COREMOD_tools/CMakeFiles/milkCOREMODtools_compute.dir/build.make src/coremods/COREMOD_tools/CMakeFiles/milkCOREMODtools_compute.dir/stringutils.c.i
.PHONY : stringutils.c.i

