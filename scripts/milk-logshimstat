#!/usr/bin/env bash
# milk-logshimstat — show status of shared memory log stream
# Thin wrapper: delegates to milk-logshim-ctrl stat

case "${1-}" in
    -h1|--help-oneline) echo "show status of shared memory log stream"; exit 0 ;;
    -h|--help) milk-logshim-ctrl --help; exit $? ;;
esac

if [ $# -ne 1 ]; then
    echo "Usage: $(basename "$0") <stream>"
    echo "   or: milk-logshim-ctrl stat <stream>"
    exit 1
fi

exec milk-logshim-ctrl stat "$1"
