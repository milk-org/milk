#!/usr/bin/env bash

MSdescr="milk-cli with all installed modules"

modulelist="milklinalgebra,milkfft,milkimagebasic,milkimagefilter,milkimageformat,milkimagegen,milkimgreduce,milkinfo,milkkdtree,milklinARfilterPred,milklinoptimtools,milk_module_example,milkpsf,milkstatistic,milkZernikePolyn"

# Handle script-level help only; pass everything else
# through to milk-cli.
case "${1-}" in
    -h1|--help-oneline)
        echo "${MSdescr}"
        exit 0 ;;
    -h2|--help-description)
        echo "Launch milk-cli with all standard plugin" \
             "modules pre-loaded. Useful for interactive" \
             "sessions that need access to FFT, linear" \
             "algebra, image processing, and statistics."
        exit 0 ;;
    -h|--help|-hm|--help-mono)
        if [ "$1" = "-hm" ] || [ "$1" = "--help-mono" ] \
            || ! [ -t 1 ]; then
            C="" R=""
        else
            C=$'\033[1;36m' R=$'\033[0m'
            HDR=$'\033[1;34m' CMD=$'\033[1;32m'
            OPT=$'\033[33m'
        fi
        : "${HDR:=}" "${CMD:=}" "${OPT:=}"
        echo "${C}milk-cli-all${R} — ${MSdescr}"
        echo ""
        echo "${HDR}Usage:${R}"
        echo "  ${CMD}milk-cli-all${R}" \
            "[${OPT}MILK OPTIONS ...${R}]"
        echo ""
        echo "${HDR}Description:${R}"
        echo "  Loads modules:"
        echo "    ${modulelist}"
        echo ""
        echo "  All arguments are forwarded to milk-cli."
        echo ""
        echo "${HDR}Options:${R}"
        echo "  ${OPT}-h, --help${R}" \
            "          Print this help message."
        echo "  ${OPT}-h1, --help-oneline${R}" \
            "  One-line description."
        echo "  ${OPT}-h2${R}" \
            "                  Verbose description."
        echo "  ${OPT}-hm${R}" \
            "                  Monochrome help."
        echo ""
        echo "${HDR}See Also:${R}"
        echo "  ${CMD}milk-exec${R}" \
            "                — execute milk-cli command"
        echo "  ${CMD}milk-commands${R}" \
            "             — list milk commands"
        exit 0
        ;;
    -hs)
        printf "%s\n" "${MSdescr}"
        exit 0
        ;;
esac

# Check if we are running from source directory
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
ROOT_DIR=$(dirname "$SCRIPT_DIR")
MILK_EXEC="milk-cli"

if [ -d "$ROOT_DIR/_build/lib" ]; then
    echo "Running from source directory, overriding MILK_INSTALLDIR to $ROOT_DIR/_build"
    export MILK_INSTALLDIR="$ROOT_DIR/_build"
    if [ -x "$ROOT_DIR/_build/milk-cli" ]; then
        MILK_EXEC="$ROOT_DIR/_build/milk-cli"
        echo "Using built executable: $MILK_EXEC"
    fi
fi

MILKCLI_APPNAME="milk-cli-all" \
    MILKCLI_ADD_LIBS="${MILKCLI_ADD_LIBS-};${modulelist}" \
    $MILK_EXEC "$@"
