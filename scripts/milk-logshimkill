#!/usr/bin/env bash
# milk-logshimkill — kill shared memory log stream process
# Thin wrapper: delegates to milk-logshim-ctrl kill

case "${1-}" in
    -h1|--help-oneline) echo "kill shared memory log stream process"; exit 0 ;;
    -h|--help) milk-logshim-ctrl --help; exit $? ;;
esac

if [ $# -ne 1 ]; then
    echo "Usage: $(basename "$0") <stream>"
    echo "   or: milk-logshim-ctrl kill <stream>"
    exit 1
fi

exec milk-logshim-ctrl kill "$1"
