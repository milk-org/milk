#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Olivier Guyon et al
# SPDX-License-Identifier: LGPL-3.0-or-later
#
# milk-script-upgrade — Convert legacy .milk or Tier-2 shorthand scripts into
# portable Tier-1 bash scripts using `source "${MILK_INSTALLDIR}/bin/milk.bash"`.

set -euo pipefail

if [[ "${1:-}" == "-h1" || "${1:-}" == "--help-oneline" ]]; then
    echo "Convert legacy .milk / Tier-2 scripts to portable Tier-1 bash scripts"
    exit 0
fi

print_help() {
    cat <<'EOF'
Usage: milk-script-upgrade [--check | --write | -i | --in-place] <script.milk>

Converts a legacy .milk script or Tier-2 shorthand script into a standalone,
ShellCheck-clean Tier-1 bash script that sources milk.bash.

Options:
  --check              Dry-run diff check (exits 1 if changes are required)
  -w, --write, -i, --in-place
                       Modify <script.milk> in place (creates <script.milk>.bak)
  -h, --help           Show this help message
  -h1, --help-oneline  Print one-line summary
EOF
}

mode="stdout"
target=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        --check|-c)
            mode="check"
            shift
            ;;
        -w|--write|-i|--in-place)
            mode="write"
            shift
            ;;
        *)
            target="$1"
            shift
            ;;
    esac
done

if [[ -z "${target}" ]]; then
    print_help >&2
    exit 1
fi

if [[ ! -f "${target}" ]]; then
    echo "Error: file not found: ${target}" >&2
    exit 1
fi

if [[ -z "${MILK_INSTALLDIR:-}" ]]; then
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    export MILK_INSTALLDIR="$(cd "${script_dir}/.." && pwd)"
fi

body="$("${MILK_INSTALLDIR}/bin/milk-call" translate --legacy "${target}")"

emit_upgraded() {
    echo "#!/usr/bin/env bash"
    if ! grep -q "milk.bash" <<<"${body}"; then
        echo 'source "${MILK_INSTALLDIR}/bin/milk.bash"'
    fi
    # Strip any old shebang on line 1 of body
    awk 'NR==1 && /^#!/ { next } { print }' <<<"${body}"
}

if [[ "${mode}" == "check" ]]; then
    tmp="${target}.chk.$$"
    trap 'rm -f "${tmp}"' EXIT
    emit_upgraded > "${tmp}"
    if diff -u "${target}" "${tmp}"; then
        exit 0
    else
        exit 1
    fi
elif [[ "${mode}" == "write" ]]; then
    cp -p "${target}" "${target}.bak"
    tmp="${target}.tmp.$$"
    emit_upgraded > "${tmp}"
    chmod +x "${tmp}"
    mv -f "${tmp}" "${target}"
else
    emit_upgraded
fi
