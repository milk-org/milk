#!/usr/bin/env bash
# milk-logshimon — resume logging a shared memory stream
# Thin wrapper: delegates to milk-logshim-ctrl on

case "${1-}" in
    -h1|--help-oneline|-h2|--help-description|-h|--help|-hm|--help-mono)
        exec milk-logshim-ctrl "$1"
        ;;
esac

if [ $# -ne 1 ]; then
    milk-logshim-ctrl --help
    exit 1
fi

exec milk-logshim-ctrl on "$1"
