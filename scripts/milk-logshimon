#!/usr/bin/env bash
# milk-logshimon — resume logging a shared memory stream
# Thin wrapper: delegates to milk-logshim-ctrl on

case "${1-}" in
    -h1|--help-oneline) echo "resume logging a shared memory stream"; exit 0 ;;
    -h|--help) milk-logshim-ctrl --help; exit $? ;;
esac

if [ $# -ne 1 ]; then
    echo "Usage: $(basename "$0") <stream>"
    echo "   or: milk-logshim-ctrl on <stream>"
    exit 1
fi

exec milk-logshim-ctrl on "$1"
