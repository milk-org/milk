#!/usr/bin/env -S milk-script -q
# milk-demopipeline
# Start a multi-stage FPS pipeline for demonstration. A milk script: each unit starts once the one
# before it has written a frame (@waitfor), with no fixed sleeps.

# Ensure we use sibling executables in the same installation directory
BINDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export PATH="${BINDIR}:${PATH}"

FRAMERATE=100

# Names of the pipeline nodes (units: FPS names)
PIPELINE_NODES=(
    mkrnd
    gaussfilt
    imtrunc
    gaussfilt2
    resizeim
    rotateim
    cropim
    streamave
    streammon
)

# SHM streams created by the pipeline
PIPELINE_STREAMS=(
    random_in
    blurred_out
    truncated_out
    smooth_out
    resized_out
    rotated_out
    cropped_out
    averaged_out
)

# ----------------------------------------------------------------
# cleanup: stop and remove the units, remove stream SHM files
# ----------------------------------------------------------------
do_cleanup()
{
    echo "Stopping milk-demopipeline processes..."

    # Determine SHM directory
    SHMDIR="${MILK_SHM_DIR:-/milk/shm}"

    for node in "${PIPELINE_NODES[@]}"; do
        milk-fps-rm -f -x "$node" >/dev/null 2>&1 || true
    done

    echo "Removing FPS shared-memory files..."
    for node in "${PIPELINE_NODES[@]}"; do
        # shellcheck disable=SC2086
        rm -f "${SHMDIR}/${node}.fps.shm" 2>/dev/null
    done

    echo "Removing stream shared-memory files..."
    for stream in "${PIPELINE_STREAMS[@]}"; do
        # shellcheck disable=SC2086
        rm -f ${SHMDIR}/${stream}*.shm 2>/dev/null
    done

    echo "Removing processinfo files..."
    for node in "${PIPELINE_NODES[@]}"; do
        # shellcheck disable=SC2086
        rm -f ${SHMDIR}/proc.${node}.*.shm 2>/dev/null
    done

    echo "Removing on-disk FPS directories..."
    for node in "${PIPELINE_NODES[@]}"; do
        rm -rf "fps.${node}.confdir" \
               "fps.${node}.datadir" 2>/dev/null
    done

    echo "Cleanup complete."
}

# ----------------------------------------------------------------
# Parse arguments
# ----------------------------------------------------------------
usage()
{
    if [ -t 1 ] && [ "$FORCE_MONOCHROME" != "1" ]; then
        MH_RST=$'\033[0m'
        MH_BOLD=$'\033[1m'
        MH_DIM=$'\033[2m'
        MH_TITLE=$'\033[1;36m'
        MH_HDR=$'\033[1;34m'
        MH_CMD=$'\033[1;32m'
        MH_OPT=$'\033[33m'
        MH_ARG=$'\033[1;35m'
        MH_DFLT=$'\033[36m'
        MH_NOTE=$'\033[1;33m'
        MH_ERR=$'\033[1;31m'
    else
        MH_RST=""
        MH_BOLD=""
        MH_DIM=""
        MH_TITLE=""
        MH_HDR=""
        MH_CMD=""
        MH_OPT=""
        MH_ARG=""
        MH_DFLT=""
        MH_NOTE=""
        MH_ERR=""
    fi

    cat <<EOF
${MH_TITLE}milk-demopipeline${MH_RST} — Start a multi-stage FPS pipeline for demonstration.

${MH_HDR}Usage:${MH_RST}
  ${MH_CMD}milk-demopipeline${MH_RST} [${MH_OPT}OPTIONS${MH_RST}] [${MH_CMD}COMMAND${MH_RST}]

${MH_HDR}Description:${MH_RST}
  This script starts a 9-node image processing chain of units,
  creating a rich graph for milk-CTRL. Each unit starts once the
  one before it has written a frame:

    random_in ──> blurred_out ──> truncated_out
                                       │
                                smooth_out
                                       │
                               resized_out
                                       │
                               rotated_out
                                       │
                               cropped_out
                                       │
                              averaged_out

  Pipeline stages:
    1. Random image generation   (random_in)
    2. Gaussian filter           (blurred_out)
    3. Image truncation          (truncated_out)
    4. Second Gaussian filter    (smooth_out)
    5. Image resize              (resized_out)
    6. Image rotation            (rotated_out)
    7. Image crop                (cropped_out)
    8. Running average           (averaged_out)
    9. Stream monitor            (stats on averaged_out)

${MH_HDR}Commands:${MH_RST}
  ${MH_CMD}cleanup${MH_RST}              Stop all pipeline processes and remove FPS/stream SHM files.

${MH_HDR}Options:${MH_RST}
  ${MH_OPT}-f, --framerate${MH_RST} ${MH_ARG}HZ${MH_RST}   Set the framerate in Hz (${MH_DFLT}default: 100${MH_RST}).
  ${MH_OPT}-h, --help${MH_RST}           Print this help message.
  ${MH_OPT}-h1, --help-oneline${MH_RST}  Print one-line description.
  ${MH_OPT}-h2${MH_RST}                  Print verbose description.
  ${MH_OPT}-hm${MH_RST}                  Monochrome help.

${MH_HDR}Environment:${MH_RST}
  MILK_SHM_DIR         Directory for shared memory files (${MH_DFLT}default: /milk/shm${MH_RST}).

${MH_HDR}See Also:${MH_RST}
  ${MH_CMD}milk-CTRL${MH_RST}
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        cleanup)
            do_cleanup
            exit 0
            ;;
        -h1|--help-oneline)
            echo "start a multi-stage FPS pipeline for demonstration"
            exit 0
            ;;
        -h2|--help-description)
            echo "Start a 9-node FPS image processing pipeline" \
                 "for demonstration and testing. Creates a chain" \
                 "of compute units (random generation, Gaussian" \
                 "blur, truncation, resize, rotation, cropping," \
                 "averaging, monitoring)" \
                 "connected via shared-memory streams, each a" \
                 "unit. Useful for testing milk-CTRL," \
                 "stream-graph, and pipeline diagnostics."
            exit 0
            ;;
        -h|--help|-hm)
            if [ "$1" = "-hm" ]; then
                FORCE_MONOCHROME=1
            fi
            usage
            exit 0
            ;;
        -f|--framerate)
            FRAMERATE="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use -h for help."
            exit 1
            ;;
    esac
done

# ----------------------------------------------------------------
# Start pipeline
# ----------------------------------------------------------------

# Frame period in seconds, and how long a stage may take to write its first frame (its input writes
# one frame per period)
@calc -v DELAY "1 / $FRAMERATE" || exit 1
@calc -v WAIT "15 + 2 * $DELAY" || exit 1

# ----------------------------------------------------------------
# wait_for_frame - wait for a frame on the stream a stage writes, so the next stage starts on data;
# without one, stop
# Usage: wait_for_frame <stream_name>
# ----------------------------------------------------------------
wait_for_frame()
{
    @waitfor "s.$1" -t "$WAIT" && return 0
    echo "  ERROR: no frame on $1 after ${WAIT}s ('milk-demopipeline cleanup' stops the units)" >&2
    exit 1
}


echo "Starting milk demo pipeline" \
     "at ${FRAMERATE} Hz..."
echo ""
echo "  random_in -> blurred_out" \
     "-> truncated_out"
echo "      -> smooth_out -> resized_out"
echo "          -> rotated_out -> cropped_out"
echo "              -> averaged_out -> [monitor]"
echo ""

# 1. Generate a 512x512 random image
milk-fpsexec-imggen-mkrandom -procinfo -loopd "$DELAY" fpsinit random_in 512 512 .distrib=0
milk-fps-set mkrnd.procinfo.RTprio 1
milk-fpsexec-imggen-mkrandom -loopd "$DELAY" runstart || exit 1
wait_for_frame random_in

# 2. Gaussian filter (sigma 5.0, size 15)
milk-fpsexec-imgfilt-gaussfilt -procinfo -loops fpsinit random_in blurred_out 5.0 15
milk-fps-set gaussfilt.procinfo.RTprio 2
milk-fpsexec-imgfilt-gaussfilt -loops runstart || exit 1
wait_for_frame blurred_out

# 3. Truncate pixel values [0.2, 0.8]
milk-fpsexec-milk-calc -n imtrunc -t blurred_out -e "truncated_out = clamp(blurred_out, 0.2, 0.8)" -procinfo -loops fpsinit
milk-fps-set imtrunc.procinfo.RTprio 3
milk-fpsexec-milk-calc -n imtrunc -loops runstart || exit 1
wait_for_frame truncated_out

# 4. Second Gaussian filter (sigma 3.0, size 7)
milk-fpsexec-imgfilt-gaussfilt -n gaussfilt2 -procinfo -loops fpsinit truncated_out smooth_out 3.0 7
milk-fps-set gaussfilt2.procinfo.RTprio 4
milk-fpsexec-imgfilt-gaussfilt -n gaussfilt2 -loops runstart || exit 1
wait_for_frame smooth_out

# 5. Resize smoothed image to 256x256
milk-fpsexec-imgbasic-resizeim -procinfo -loops fpsinit smooth_out resized_out 256 256
milk-fps-set resizeim.procinfo.RTprio 5
milk-fpsexec-imgbasic-resizeim -loops runstart || exit 1
wait_for_frame resized_out

# 6. Image rotation
milk-fpsexec-imgbasic-rotateim -procinfo -loops fpsinit resized_out rotated_out 45.0
milk-fps-set rotateim.procinfo.RTprio 6
milk-fpsexec-imgbasic-rotateim -loops runstart || exit 1
wait_for_frame rotated_out

# 7. Image crop
milk-fpsexec-milk-calc -n cropim -t rotated_out -e "cropped_out = rotated_out[64:192, 64:192]" -procinfo -loops fpsinit
milk-fps-set cropim.procinfo.RTprio 7
milk-fpsexec-milk-calc -n cropim -loops runstart || exit 1
wait_for_frame cropped_out

# 8. Running average (window 10)
milk-fpsexec-mem-streamave -procinfo -loops fpsinit cropped_out averaged_out 10
milk-fps-set streamave.procinfo.RTprio 8
milk-fpsexec-mem-streamave -loops runstart || exit 1
wait_for_frame averaged_out

# 9. Stream monitor on the final output
milk-fpsexec-info-strmonproc -n streammon -procinfo -loops fpsinit averaged_out 1 100
milk-fps-set streammon.procinfo.RTprio 9
milk-fpsexec-info-strmonproc -n streammon -loops runstart || exit 1

echo ""
echo "Pipeline started (milk-fps-list; milk-fps-log NAME for a unit's output)."
echo "Run 'milk-CTRL' and press D on a stream"
echo "to see ancestors/descendants."
echo ""
echo "Run 'milk-demopipeline cleanup' to stop."
