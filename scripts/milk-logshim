#!/usr/bin/env bash
# milk-logshim — log shared memory image stream to disk
# Thin wrapper: delegates to milk-logshim-ctrl + milk-streamFITSlog

case "${1-}" in
    -h1|--help-oneline) echo "log shared memory image stream to disk"; exit 0 ;;
esac

CPUSET_ARGS=()

# Parse -c <cpuset> before forwarding
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        -c) CPUSET_ARGS=(-c "$2"); shift 2 ;;
        *)  ARGS+=("$1"); shift ;;
    esac
done

STREAM="${ARGS[0]-}"
BLOCKSIZE="${ARGS[1]-}"
DIR="${ARGS[2]-}"

if [ -z "$STREAM" ] || [ -z "$BLOCKSIZE" ] || [ -z "$DIR" ]; then
    echo "Usage: $(basename "$0") [-c <cpuset>] <stream> <blocksize> <directory>"
    echo "   or: milk-logshim-ctrl start <stream> <blocksize> <directory> [-c <cpuset>]"
    exit 1
fi

exec milk-logshim-ctrl start "$STREAM" "$BLOCKSIZE" "$DIR" "${CPUSET_ARGS[@]}"
