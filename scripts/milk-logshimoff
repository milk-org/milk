#!/usr/bin/env bash
# milk-logshimoff — stop logging a shared memory stream
# Thin wrapper: delegates to milk-logshim-ctrl off

case "${1-}" in
    -h1|--help-oneline) echo "stop logging a shared memory stream"; exit 0 ;;
    -h|--help) milk-logshim-ctrl --help; exit $? ;;
esac

if [ $# -ne 1 ]; then
    echo "Usage: $(basename "$0") <stream>"
    echo "   or: milk-logshim-ctrl off <stream>"
    exit 1
fi

exec milk-logshim-ctrl off "$1"
