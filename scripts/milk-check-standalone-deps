#!/usr/bin/env bash
# milk-check-standalone-deps
#
# CI guard: verify standalone executables do not link CLIcore
# unless they are on the known-exception list.
#
# Usage:
#   milk-check-standalone-deps [install-prefix]
#
# If install-prefix is omitted, uses the first directory
# in PATH that contains milk-fpsexec-help.
#
# Exit code 0 = all OK, 1 = unexpected CLIcore dependency.

# Early-exit help flags (before set -euo pipefail)
case "${1-}" in
    -h1|--help-oneline)
        echo "verify standalone executables do not link CLIcore unexpectedly"
        exit 0 ;;
    -h2|--help-description)
        echo "CI guard: verify milk-fpsexec-* and" \
             "cacao-fpsexec-* binaries do not link" \
             "libCLIcore unless on the known-exception" \
             "list. Exit 0 = all OK, 1 = unexpected" \
             "CLIcore dependency found."
        exit 0 ;;
    -h|--help|-hm|--help-mono)
        if [ "$1" = "-hm" ] || [ "$1" = "--help-mono" ] \
            || ! [ -t 1 ]; then
            T="" R="" H="" C="" O="" A=""
        else
            T=$'\033[1;36m' R=$'\033[0m'
            H=$'\033[1;34m' C=$'\033[1;32m'
            O=$'\033[33m'   A=$'\033[1;35m'
        fi
        echo "${T}milk-check-standalone-deps${R}" \
            "— verify standalone executables do" \
            "not link CLIcore unexpectedly"
        echo ""
        echo "${H}Usage:${R}"
        echo "  ${C}milk-check-standalone-deps${R}" \
            "[${A}install-prefix${R}]"
        echo ""
        echo "${H}Description:${R}"
        echo "  CI guard: verify milk-fpsexec-* and" \
             "cacao-fpsexec-* binaries do not link"
        echo "  libCLIcore unless on the" \
             "known-exception list."
        echo "  Exit 0 = all OK, 1 = unexpected" \
             "CLIcore dependency found."
        echo ""
        echo "${H}Options:${R}"
        echo "  ${O}-h, --help${R}" \
            "           Print this help."
        echo "  ${O}-h1, --help-oneline${R}" \
            "   One-line description."
        echo "  ${O}-h2${R}" \
            "                   Verbose description."
        echo "  ${O}-hm${R}" \
            "                   Monochrome help."
        echo ""
        echo "${H}See Also:${R}"
        echo "  ${C}milk-check${R}" \
            "               — check milk installation"
        exit 0 ;;
esac

set -euo pipefail

# --- Locate install prefix ---
PREFIX="${1:-}"
if [ -z "$PREFIX" ]; then
    PREFIX="$(dirname "$(command -v milk-fpsexec-help)")"
fi

# --- Known exceptions ---
# Standalones that legitimately need their module lib
# (and thus CLIcore) for symbols or include paths.
EXCEPTIONS=(
    milk-fpsexec-clustering-cubeclust
    milk-fpsexec-fft-dofft
    milk-fpsexec-fft-pup2foc
    milk-fpsexec-imgfmt-combineHDR
    milk-fpsexec-info-imagemon
    milk-fpsexec-linalg-PCAmatch
    milk-fpsexec-linalg-SVD
    milk-fpsexec-linalg-SVDmkU
    milk-fpsexec-linalg-SVDmkM
    milk-fpsexec-linalg-modalremap
    milk-fpsexec-linopt-lin1Dfit
    milk-fpsexec-linopt-linRM
    milk-fpsexec-linopt-imgFitModes
    milk-fpsexec-linpred-buildlinPF
    milk-fpsexec-zernike-mkzercube
    cacao-fpsexec-cacaopt-mlat
    cacao-fpsexec-cacaopt-zoptsearch
    cacao-fpsexec-cacaopt-mlatdecode
    cacao-fpsexec-cacaocc-compctrlmodes
    cacao-fpsexec-cacaocc-compmaskwfsdm
)

is_exception() {
    local name="$1"
    for exc in "${EXCEPTIONS[@]}"; do
        [ "$name" = "$exc" ] && return 0
    done
    return 1
}

# --- Scan ---
# Works for both flat install dirs and recursive build trees.
fail=0
clean=0
excepted=0
unexpected=0

while IFS= read -r exe; do
    [ -f "$exe" ] || continue
    name="$(basename "$exe")"

    if ldd "$exe" 2>/dev/null | grep -q "libCLIcore"; then
        if is_exception "$name"; then
            excepted=$((excepted + 1))
        else
            printf "FAIL  %s links CLIcore\n" "$name"
            unexpected=$((unexpected + 1))
        fi
    else
        clean=$((clean + 1))
    fi
done < <(find "$PREFIX" -type f \
    \( -name "milk-fpsexec-*" -o -name "cacao-fpsexec-*" \) \
    -executable 2>/dev/null)

printf "\n--- Summary ---\n"
printf "CLIcore-free : %d\n" "$clean"
printf "Excepted     : %d\n" "$excepted"
printf "Unexpected   : %d\n" "$unexpected"

if [ "$unexpected" -gt 0 ]; then
    printf "\nFAILED: %d standalone(s) link CLIcore unexpectedly.\n" \
           "$unexpected"
    printf "If intentional, add them to EXCEPTIONS in %s\n" "$0"
    exit 1
fi

printf "\nPASSED: no unexpected CLIcore dependencies.\n"
exit 0
