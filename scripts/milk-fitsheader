#!/usr/bin/env bash

# Early-exit help flags (getopts cannot handle long options)
case "${1-}" in
    -h1|--help-oneline)
        echo "print or extract FITS file header"
        exit 0 ;;
    -h2|--help-description)
        echo "Print FITS header to stdout. With -w," \
             "also write each file's header to" \
             "<file>.header on disk."
        exit 0 ;;
    -h|--help|-hm|--help-mono)
        if [ "$1" = "-hm" ] || [ "$1" = "--help-mono" ] \
            || ! [ -t 1 ]; then
            T="" R="" H="" C="" O="" A=""
        else
            T=$'\033[1;36m' R=$'\033[0m'
            H=$'\033[1;34m' C=$'\033[1;32m'
            O=$'\033[33m'   A=$'\033[1;35m'
        fi
        echo "${T}milk-fitsheader${R}" \
            "— print or extract FITS file header"
        echo ""
        echo "${H}Usage:${R}"
        echo "  ${C}milk-fitsheader${R}" \
            "[${O}-w${R}] ${A}file1${R}" \
            "[${A}file2${R} ...]"
        echo ""
        echo "${H}Description:${R}"
        echo "  Print FITS header to stdout."
        echo "  With ${O}-w${R}, also write" \
             "<file>.header."
        echo ""
        echo "${H}Options:${R}"
        echo "  ${O}-w${R}" \
            "  Write header to <file>.header"
        echo ""
        echo "${H}See Also:${R}"
        echo "  ${C}milk-cr2tofits${R}" \
            "            — convert CR2 to FITS"
        echo "  ${C}milk-FITS2shm${R}" \
            "             — load FITS to shared memory"
        exit 0 ;;
esac

writeoutput=false

while getopts "w" opt; do
  case $opt in
    w)
      writeoutput=true
      ;;
    \?) # Handle invalid options
      echo "Invalid option: -$OPTARG" >&2
      exit 1
      ;;
  esac
done

# Shift positional parameters past the options
shift "$((OPTIND - 1))"


# Check if any files are provided
if [ "$#" -eq 0 ]; then
  echo "Usage: $0 [-w] <file1> [file2 ...]"
  echo " -w : Write FITS header as <file>.header"
  exit 1
fi

CNTskipped=0
CNTproc=0

for file in "$@"; do
  if [ -f "$file" ]; then

extension="${file##*.}"
filename_no_extension="${file%.*}"
#echo "Extension = $extension"
#echo "filename_no_extension= = $filename_no_extension"

filename="${file}"
if [[ $extension == "fz" ]];then
  outfile="${filename_no_extension}.header"
else
  outfile="$filename.header"
fi

    
if [ -f $outfile ]; then
  CNTskipped=$((CNTskipped + 1))
  #echo "    File $outfile exists -> skipping"
else
  CNTproc=$((CNTproc + 1))
if $writeoutput; then
  if [[ $extension == "fz" ]];then
    cat $filename | fold -w 80 | sed '1,/COMPRESSED_IMAGE/ d' | sed '/END                  /Q' > $outfile
  else
    cat $filename | fold -w 80 | sed '/END                  /Q' > $outfile
  fi
else
  if [[ $extension == "fz" ]];then
    cat $filename | fold -w 80 | sed '1,/COMPRESSED_IMAGE/ d' | sed '/END                  /Q' 
  else
    cat $filename | fold -w 80 | sed '/END                  /Q'
  fi
fi
fi
    # echo "Processing file: $file"
#  else
    #echo "Warning: '$file' is not a regular file, skipping."
  fi

done



printf "%50s   %5d proc   %5d skip\n" "$PWD" $CNTproc $CNTskipped




