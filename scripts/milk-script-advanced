#!/usr/bin/env bash

# ==============================================================================
# NAME: milk-script-advanced
# DESC: Advanced native milk-cli script template
# ==============================================================================
# 1. BASH HEADER: Configuration & Argument Parsing
# ==============================================================================
MSdescr="advanced native milk-cli script template with bash argument parsing"

# Early-exit for -h1 before any sourcing
case "${1-}" in
    -h1|--help-oneline) echo "${MSdescr}"; exit 0 ;;
esac

# standard configuration
source milk-script-std-config

MSextdescr="Demonstrates leveraging milk-cli native processing with robust bash args.
This script uses standard bash for argument parsing and prerequisite checks,
and then drops into a native milk-cli heredoc block for zero-overhead execution."

# Prerequisites
RequiredCommands=(tmux milk-cli)
RequiredFiles=()
RequiredDirs=()
RequiredPipes=()

# Arguments
MSarg+=( "streamname:string:Name of the input stream to wait for" )
MSarg+=( "gain:float:Gain to apply to the FPS control (e.g. 0.5)" )

# Options
MSopt+=( "v:verbose:verbosefunc::Enable verbose output" )
function verbosefunc() { export SCRIPT_VERBOSE=1; }

# parse arguments
# milk-argparse automatically creates and exports uppercase ENV vars
# of our arguments ($STREAMNAME, $GAIN) for native use in milk-cli
MSseealso+=( "milk-scriptexample:example milk script" )
MSseealso+=( "milk-tutorial:milk tutorial by examples" )

source milk-argparse

# ==============================================================================
# 2. NATIVE EXECUTION: Zero-Overhead milk-cli Block
# ==============================================================================
# The quoted 'EOF' keeps bash from expanding the block here: milk-script expands it, with
# $STREAMNAME and $GAIN exported by milk-argparse.

milk-script -q - << 'EOF'

# --- A. Orchestration & Waiting ---
echo "Waiting for stream: $STREAMNAME..."
if ! @waitfor "s.$STREAMNAME" -t 10; then
    echo "Timeout waiting for $STREAMNAME"
    exit 1
fi

# --- B. Stream metadata ---
nx=@s.${STREAMNAME}.xsize
ny=@s.${STREAMNAME}.ysize
echo "Stream is online. Shape is: ${nx}x${ny}"

# --- C. Image math ---
echo "Allocating mask image..."
mem.mk2Dim "@L:mask_img" "$nx" "$ny"
@calc "mask_img = mask_img * 0.0 + 1.0"

# --- D. Event trigger ---
echo "Waiting for the next frame..."
@waitfor "s.$STREAMNAME" -t 10 && echo "Frame arrived!"

echo "Script complete."
EOF
