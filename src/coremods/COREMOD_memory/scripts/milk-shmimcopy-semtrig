#!/usr/bin/env bash
# milk-shmimcopy-semtrig — copy stream data content with semaphore trigger
# Thin wrapper: delegates to milk-fpsexec-mem-streamcopy

case "${1-}" in
    -h1|--help-oneline) echo "copy stream data content"; exit 0 ;;
    -h2|--help-description) milk-fpsexec-mem-streamcopy -h2; exit $? ;;
    -h|--help|-hm|--help-mono) milk-fpsexec-mem-streamcopy "$1"; exit $? ;;
esac

exec milk-fpsexec-mem-streamcopy "$@"
