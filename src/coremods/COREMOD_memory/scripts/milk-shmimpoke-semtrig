#!/usr/bin/env bash
# milk-shmimpoke-semtrig — poke existing stream from stream trigger
# Thin wrapper: delegates to milk-fpsexec-mem-streampoke
# (semaphore trigger mode is set via FPS parameters)

case "${1-}" in
    -h1|--help-oneline) echo "poke existing stream from stream trigger"; exit 0 ;;
    -h2|--help-description) milk-fpsexec-mem-streampoke -h2; exit $? ;;
    -h|--help|-hm|--help-mono) milk-fpsexec-mem-streampoke "$1"; exit $? ;;
esac

exec milk-fpsexec-mem-streampoke "$@"
