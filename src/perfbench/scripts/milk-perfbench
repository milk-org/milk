#!/usr/bin/env bash

# This script uses milk-argparse
# See template milk-scriptexample in module
# milk_module_example for template and instructions

# script 1-line description
MSdescr="benchmark an FPS compute unit"

# Extended description
MSextdescr="Runs an FPS standalone executable under
perf stat to collect hardware counters (cache misses,
branch mispredictions, IPC), then reads processinfo
SHM for timing data. Outputs a JSON result file.

Requires: perf (linux-tools)
"

# standard configuration
source milk-script-std-config

# prerequisites
RequiredCommands=( perf )
RequiredFiles=()
RequiredDirs=()

# SCRIPT ARGUMENTS (mandatory)
# syntax: "name:type(s)/test(s):description"

MSarg+=( "fpsexec:string:fpsexec command name" )
MSarg+=( "nbiter:int:number of iterations" )

# SCRIPT OPTIONS
# syntax: "short:long:functioncall:args[types]:descr"

OUTDIR="./perfresults"
MSopt+=( "o:outdir:set_outdir:dir[string]:output directory for results" )
function set_outdir() {
    OUTDIR="$1"
}

FPSARGS=""
MSopt+=( "a:fpsargs:set_fpsargs:args[string]:extra args passed to fpsexec set" )
function set_fpsargs() {
    FPSARGS="$1"
}

SETUPCMD=""
MSopt+=( "s:setup:set_setup:cmd[string]:setup command run before benchmark" )
function set_setup() {
    SETUPCMD="$1"
}

# parse arguments
source milk-argparse

FPSEXEC="${inputMSargARRAY[0]}"
NBITER="${inputMSargARRAY[1]}"

# =========================================
# VALIDATION
# =========================================

if ! command -v "${FPSEXEC}" &>/dev/null; then
    echo "ERROR: command '${FPSEXEC}' not found"
    exit 1
fi

if ! command -v perf &>/dev/null; then
    echo "ERROR: 'perf' not found."
    echo "Install linux-tools for your kernel."
    exit 1
fi

# =========================================
# SETUP
# =========================================

mkdir -p "${OUTDIR}"

# Unique run ID based on timestamp
RUNID=$(date +%Y%m%dT%H%M%S)
RESULT_FILE="${OUTDIR}/${FPSEXEC}-${RUNID}.json"

# Temporary files
PERF_OUT=$(mktemp /tmp/perfbench-perf.XXXXXX)
PROCINFO_OUT=$(mktemp /tmp/perfbench-pinfo.XXXXXX)

# Get git commit if available
GIT_COMMIT="unknown"
if command -v git &>/dev/null; then
    GIT_COMMIT=$(git -C "$(dirname "$0")" \
        rev-parse --short HEAD 2>/dev/null \
        || echo "unknown")
fi

# Determine processinfo SHM directory
if [ -n "${MILK_SHM_DIR}" ]; then
    PROCDIR="${MILK_SHM_DIR}"
elif [ -d "/milk/shm" ]; then
    PROCDIR="/milk/shm"
else
    PROCDIR="/tmp"
fi

# =========================================
# FPS LIFECYCLE BENCHMARK
# =========================================

# Unique FPS name to avoid collisions
FPSNAME="pb$(date +%s%N | tail -c 8)"

# Cleanup function
cleanup_fps() {
    local shmdir
    if [ -n "${MILK_SHM_DIR}" ]; then
        shmdir="${MILK_SHM_DIR}"
    elif [ -d "/milk/shm" ]; then
        shmdir="/milk/shm"
    else
        shmdir="/tmp"
    fi
    rm -f "${shmdir}/fps.${FPSNAME}"*.shm \
          2>/dev/null
    rm -rf "${shmdir}/${FPSNAME}.fps.datadir" \
           2>/dev/null
    rm -f /tmp/perfbench-perf.* \
          /tmp/perfbench-pinfo.* 2>/dev/null
}
trap cleanup_fps EXIT

echo ""
echo "======================================="
echo "  milk-perfbench"
echo "======================================="
echo "  Command   : ${FPSEXEC}"
echo "  FPS name  : ${FPSNAME}"
echo "  Iterations: ${NBITER}"
echo "  Output    : ${RESULT_FILE}"
echo "======================================="
echo ""

# Step 1: Create FPS with processinfo enabled
echo "[1/4] fpsinit -procinfo ..."
${FPSEXEC} ${FPSNAME}:fpsinit -procinfo

# Step 2: Configuration step
# This creates the .procinfo.* entries
echo "[2/4] confstep ..."
${FPSEXEC} ${FPSNAME}:confstep

# Step 3: Set benchmark parameters
echo "[3/5] Setting FPS params ..."
# Enable processinfo
milk-fps-set \
    ${FPSNAME}.procinfo.enabled ON
# Enable timing measurement
milk-fps-set \
    ${FPSNAME}.procinfo.MeasureTiming ON
# triggermode 0 = IMMEDIATE (no wait)
milk-fps-set \
    ${FPSNAME}.procinfo.triggermode 0
# Set max iteration count
milk-fps-set \
    ${FPSNAME}.procinfo.loopcntMax ${NBITER}

# Set any extra positional args (stream names)
if [ -n "${FPSARGS}" ]; then
    ${FPSEXEC} ${FPSNAME}:set ${FPSARGS}
fi

# Step 4: Auto-create missing streams
echo "[4/6] Creating missing streams ..."
# Query FPS for STREAMNAME parameters and
# create any streams that don't exist yet.
# Strip ANSI codes, find STREAMNAME type
# entries, extract the value (field 4).
SHMDIR="${MILK_SHM_DIR:-/milk/shm}"
${FPSEXEC} ${FPSNAME}:fps 2>/dev/null \
    | sed 's/\x1b\[[0-9;]*m//g' \
    | awk '$3 == "STREAMNAME" && NF >= 8 \
           { print $4 }' \
    | while read -r SNAME; do
    if [ -z "${SNAME}" ]; then
        continue
    fi
    if [ ! -f "${SHMDIR}/${SNAME}.im.shm" ]; then
        echo "  Creating stream: ${SNAME} (32x32)"
        milk-perfbench-mkstream \
            "${SNAME}" 32 32
    else
        echo "  Stream exists: ${SNAME}"
    fi
done

# Run user setup command if provided
if [ -n "${SETUPCMD}" ]; then
    echo "[5/6] Setup: ${SETUPCMD}"
    eval "${SETUPCMD}"
else
    echo "[5/6] No setup command"
fi

# Step 6: Run the benchmark
echo "[6/6] Running ${NBITER} iterations ..."

# Temporarily disable set -e and ERR trap:
# perf stat may fail (permissions), and
# grep/sed in parsing may return non-zero
# when perf data is unavailable.
_SAVED_ERR_TRAP=$(trap -p ERR)
set +eE
trap - ERR

# Probe: can perf stat actually run commands?
# With perf_event_paranoid=4, perf stat exits
# 255 WITHOUT executing the child command.
PERF_CAN_RUN=0
perf stat -- true 2>/dev/null
if [ $? -ne 255 ]; then
    PERF_CAN_RUN=1
fi

TSTART=$(date +%s%N)

if [ ${PERF_CAN_RUN} -eq 1 ]; then
    perf stat \
        -j \
        -e cycles \
        -e instructions \
        -e bus-cycles \
        -e L1-dcache-loads \
        -e L1-dcache-load-misses \
        -e L1-dcache-stores \
        -e L1-icache-loads \
        -e L1-icache-load-misses \
        -e iTLB-load-misses \
        -e LLC-loads \
        -e LLC-load-misses \
        -e LLC-stores \
        -e LLC-store-misses \
        -e dTLB-loads \
        -e dTLB-load-misses \
        -e dTLB-store-misses \
        -e branch-misses \
        -e branches \
        -e page-faults \
        -e minor-faults \
        -e major-faults \
        -e cpu-migrations \
        -e context-switches \
        -e task-clock \
        -o "${PERF_OUT}" \
        -- ${FPSEXEC} ${FPSNAME}:runstart \
        2>/dev/null
    PERF_EXIT=$?
else
    echo "  perf stat unavailable" \
         "(perf_event_paranoid), running" \
         "without hardware counters"
    ${FPSEXEC} ${FPSNAME}:runstart \
        >/dev/null 2>&1
    PERF_EXIT=$?
fi

TEND=$(date +%s%N)

if [ ${PERF_EXIT} -ne 0 ]; then
    echo "WARNING: perf stat exited with" \
        "code ${PERF_EXIT}"
fi

# Wall-clock time
ELAPSED_NS=$(( TEND - TSTART ))
ELAPSED_S=$(echo "scale=6; ${ELAPSED_NS} / 1000000000" \
    | bc)

# =========================================
# READ PROCESSINFO
# =========================================

# Find the processinfo SHM file for the fpsexec
# The file is named proc.<name>.<PID>.shm
# We search for the most recently modified match
PINFO_FILE=""
PINFO_FILE=$(find "${PROCDIR}" \
    -maxdepth 1 \
    -name "proc.*.shm" \
    -newer "${PERF_OUT}" \
    -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn \
    | head -1 \
    | awk '{print $2}')

HAVE_PROCINFO=0
if [ -n "${PINFO_FILE}" ] && [ -f "${PINFO_FILE}" ]; then
    milk-perfbench-readprocinfo \
        "${PINFO_FILE}" > "${PROCINFO_OUT}" 2>/dev/null
    if [ $? -eq 0 ]; then
        HAVE_PROCINFO=1
    fi
fi

# =========================================
# PARSE PERF STAT OUTPUT
# =========================================

# Extract counters from perf stat JSON lines.
# On hybrid CPUs (Intel P+E), events appear as
# "cpu_atom/cycles/" and "cpu_core/cycles/"
# instead of plain "cycles". We match the event
# basename and sum values from all core types.
get_perf_counter() {
    local event="$1"
    local total=0
    local found=0

    # Match exact name or */name/ pattern
    while IFS= read -r line; do
        val=$(echo "${line}" \
            | grep -o \
                '"counter-value" *: *"[^"]*"' \
            | sed 's/.*: *"\([^"]*\)"/\1/' \
            | tr -d ',')
        # Only accept numeric values (skip
        # <not counted>, <not supported>, etc)
        if echo "${val}" \
            | grep -qE '^[0-9]+\.?[0-9]*$'
        then
            total=$(echo "${total} + ${val}" \
                | bc)
            found=1
        fi
    done < <(grep -E \
        "\"(${event}|[^\"]*/${event}/[^\"]*)\"" \
        "${PERF_OUT}" 2>/dev/null)

    if [ ${found} -eq 1 ]; then
        # Truncate to integer
        echo "${total}" | sed 's/\..*//'
    else
        echo "0"
    fi
}

CYCLES=$(get_perf_counter "cycles")
BUS_CYCLES=$(get_perf_counter "bus-cycles")
INSTRUCTIONS=$(get_perf_counter "instructions")
L1D_LOADS=$(get_perf_counter "L1-dcache-loads")
L1D_MISSES=$(get_perf_counter "L1-dcache-load-misses")
L1D_STORES=$(get_perf_counter "L1-dcache-stores")
L1I_LOADS=$(get_perf_counter "L1-icache-loads")
L1I_MISSES=$(get_perf_counter "L1-icache-load-misses")
ITLB_MISSES=$(get_perf_counter "iTLB-load-misses")
LLC_LOADS=$(get_perf_counter "LLC-loads")
LLC_MISSES=$(get_perf_counter "LLC-load-misses")
LLC_STORES=$(get_perf_counter "LLC-stores")
LLC_ST_MISSES=$(get_perf_counter "LLC-store-misses")
DTLB_LOADS=$(get_perf_counter "dTLB-loads")
DTLB_MISSES=$(get_perf_counter "dTLB-load-misses")
DTLB_ST_MISSES=$(get_perf_counter "dTLB-store-misses")
BRANCH_MISSES=$(get_perf_counter "branch-misses")
BRANCHES=$(get_perf_counter "branches")
PAGE_FAULTS=$(get_perf_counter "page-faults")
MINOR_FAULTS=$(get_perf_counter "minor-faults")
MAJOR_FAULTS=$(get_perf_counter "major-faults")
CPU_MIGRATIONS=$(get_perf_counter "cpu-migrations")
CTX_SWITCHES=$(get_perf_counter "context-switches")
TASK_CLOCK=$(get_perf_counter "task-clock")

# Executable file size
EXE_PATH=$(command -v "${FPSEXEC}" 2>/dev/null)
EXE_SIZE=0
if [ -n "${EXE_PATH}" ]; then
    EXE_SIZE=$(stat --format=%s \
        "${EXE_PATH}" 2>/dev/null || echo 0)
fi

# Compute IPC if we have both values
IPC="0"
if [ -n "${INSTRUCTIONS}" ] \
    && [ -n "${CYCLES}" ] \
    && [ "${CYCLES}" != "0" ]; then
    IPC=$(echo "scale=3; \
        ${INSTRUCTIONS} / ${CYCLES}" \
        | bc 2>/dev/null || echo "0")
fi

# Compute miss rates (6 decimal places)
miss_rate() {
    local misses="$1" loads="$2"
    if [ "${loads}" != "0" ] \
       && [ -n "${loads}" ]; then
        echo "scale=6; \
            100 * ${misses} / ${loads}" \
            | bc 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}
L1D_MISS_PCT=$(miss_rate ${L1D_MISSES} ${L1D_LOADS})
L1I_MISS_PCT=$(miss_rate ${L1I_MISSES} ${L1I_LOADS})
LLC_MISS_PCT=$(miss_rate ${LLC_MISSES} ${LLC_LOADS})
LLC_ST_MISS_PCT=$(miss_rate \
    ${LLC_ST_MISSES} ${LLC_STORES})
DTLB_MISS_PCT=$(miss_rate \
    ${DTLB_MISSES} ${DTLB_LOADS})

: "${CYCLES:=0}"
: "${BUS_CYCLES:=0}"
: "${INSTRUCTIONS:=0}"
: "${L1D_LOADS:=0}"
: "${L1D_MISSES:=0}"
: "${L1D_STORES:=0}"
: "${L1I_LOADS:=0}"
: "${L1I_MISSES:=0}"
: "${ITLB_MISSES:=0}"
: "${LLC_LOADS:=0}"
: "${LLC_MISSES:=0}"
: "${LLC_STORES:=0}"
: "${LLC_ST_MISSES:=0}"
: "${DTLB_LOADS:=0}"
: "${DTLB_MISSES:=0}"
: "${DTLB_ST_MISSES:=0}"
: "${BRANCH_MISSES:=0}"
: "${BRANCHES:=0}"
: "${PAGE_FAULTS:=0}"
: "${MINOR_FAULTS:=0}"
: "${MAJOR_FAULTS:=0}"
: "${CPU_MIGRATIONS:=0}"
: "${CTX_SWITCHES:=0}"
: "${TASK_CLOCK:=0}"

# Re-enable strict error checking + ERR trap
set -eE
eval "${_SAVED_ERR_TRAP}"

# =========================================
# GENERATE JSON OUTPUT
# =========================================

{
echo "{"
echo "  \"timestamp\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","
echo "  \"compute_unit\": \"${FPSEXEC}\","
echo "  \"exe_size_bytes\": ${EXE_SIZE},"
echo "  \"git_commit\": \"${GIT_COMMIT}\","
echo "  \"iterations\": ${NBITER},"
echo "  \"wall_clock_s\": ${ELAPSED_S},"

echo "  \"hw_counters\": {"
echo "    \"cycles\": ${CYCLES},"
echo "    \"bus_cycles\": ${BUS_CYCLES},"
echo "    \"instructions\": ${INSTRUCTIONS},"
echo "    \"ipc\": ${IPC},"
echo "    \"L1_dcache_loads\": ${L1D_LOADS},"
echo "    \"L1_dcache_misses\": ${L1D_MISSES},"
echo "    \"L1_dcache_miss_pct\": ${L1D_MISS_PCT},"
echo "    \"L1_dcache_stores\": ${L1D_STORES},"
echo "    \"L1_icache_loads\": ${L1I_LOADS},"
echo "    \"L1_icache_misses\": ${L1I_MISSES},"
echo "    \"L1_icache_miss_pct\": ${L1I_MISS_PCT},"
echo "    \"iTLB_misses\": ${ITLB_MISSES},"
echo "    \"LLC_loads\": ${LLC_LOADS},"
echo "    \"LLC_misses\": ${LLC_MISSES},"
echo "    \"LLC_miss_pct\": ${LLC_MISS_PCT},"
echo "    \"LLC_stores\": ${LLC_STORES},"
echo "    \"LLC_store_misses\": ${LLC_ST_MISSES},"
echo "    \"LLC_store_miss_pct\": ${LLC_ST_MISS_PCT},"
echo "    \"dTLB_loads\": ${DTLB_LOADS},"
echo "    \"dTLB_misses\": ${DTLB_MISSES},"
echo "    \"dTLB_miss_pct\": ${DTLB_MISS_PCT},"
echo "    \"dTLB_store_misses\": ${DTLB_ST_MISSES},"
echo "    \"branch_misses\": ${BRANCH_MISSES},"
echo "    \"branches\": ${BRANCHES},"
echo "    \"page_faults\": ${PAGE_FAULTS},"
echo "    \"minor_faults\": ${MINOR_FAULTS},"
echo "    \"major_faults\": ${MAJOR_FAULTS},"
echo "    \"cpu_migrations\": ${CPU_MIGRATIONS},"
echo "    \"context_switches\": ${CTX_SWITCHES},"
echo "    \"task_clock_ms\": ${TASK_CLOCK}"
echo "  },"

# Processinfo timing (if available)
if [ "${HAVE_PROCINFO}" -eq 1 ]; then
    # Extract fields from procinfo JSON
    extract_json() {
        grep "\"$1\"" "${PROCINFO_OUT}" \
            | head -1 \
            | sed 's/.*: *\([0-9-]*\).*/\1/'
    }
    PI_MED_ITER=$(extract_json "median_iter_ns")
    PI_MED_EXEC=$(extract_json "median_exec_ns")
    PI_P50_EXEC=$(extract_json "p50_exec_ns")
    PI_P95_EXEC=$(extract_json "p95_exec_ns")
    PI_P99_EXEC=$(extract_json "p99_exec_ns")
    PI_P50_ITER=$(extract_json "p50_iter_ns")
    PI_P95_ITER=$(extract_json "p95_iter_ns")
    PI_P99_ITER=$(extract_json "p99_iter_ns")
    PI_VMPEAK=$(extract_json "vmpeak_kb")
    PI_VMHWM=$(extract_json "vmhwm_kb")
    PI_VMRSS=$(extract_json "vmrss_kb")
    PI_LOOPCNT=$(extract_json "loopcnt")

    : "${PI_MED_ITER:=0}"
    : "${PI_MED_EXEC:=0}"
    : "${PI_P50_EXEC:=0}"
    : "${PI_P95_EXEC:=0}"
    : "${PI_P99_EXEC:=0}"
    : "${PI_P50_ITER:=0}"
    : "${PI_P95_ITER:=0}"
    : "${PI_P99_ITER:=0}"
    : "${PI_VMPEAK:=-1}"
    : "${PI_VMHWM:=-1}"
    : "${PI_VMRSS:=-1}"
    : "${PI_LOOPCNT:=0}"

    echo "  \"processinfo\": {"
    echo "    \"loopcnt\": ${PI_LOOPCNT},"
    echo "    \"median_iter_ns\": ${PI_MED_ITER},"
    echo "    \"median_exec_ns\": ${PI_MED_EXEC},"
    echo "    \"p50_exec_ns\": ${PI_P50_EXEC},"
    echo "    \"p95_exec_ns\": ${PI_P95_EXEC},"
    echo "    \"p99_exec_ns\": ${PI_P99_EXEC},"
    echo "    \"p50_iter_ns\": ${PI_P50_ITER},"
    echo "    \"p95_iter_ns\": ${PI_P95_ITER},"
    echo "    \"p99_iter_ns\": ${PI_P99_ITER},"
    echo "    \"vmpeak_kb\": ${PI_VMPEAK},"
    echo "    \"vmhwm_kb\": ${PI_VMHWM},"
    echo "    \"vmrss_kb\": ${PI_VMRSS}"
    echo "  }"
else
    echo "  \"processinfo\": null"
fi

echo "}"
} > "${RESULT_FILE}"

# =========================================
# SUMMARY
# =========================================

# per-iteration helper: total / NBITER
per_iter() {
    local v="$1"
    if [ "${v}" = "0" ] || [ -z "${v}" ]; then
        echo "0"
    else
        echo "scale=1; ${v} / ${NBITER}" \
            | bc 2>/dev/null || echo "0"
    fi
}

FMT="  %-26s %14s %12s/iter\n"
FMTHDR="  %-26s %14s %12s\n"
FMTS="  %-26s %14s\n"

echo ""
echo "======================================================"
echo "  Benchmark Results (${NBITER} iterations)"
echo "======================================================"
printf "${FMTHDR}" "" "Total" "Per-iter"
echo "  ------------------------------------------------------"
printf "${FMT}" "Wall clock" \
    "${ELAPSED_S} s" \
    "$(echo "scale=1; ${ELAPSED_NS} / ${NBITER}" \
        | bc) ns"
printf "${FMT}" "Cycles" \
    "${CYCLES}" "$(per_iter ${CYCLES})"
printf "${FMT}" "Bus cycles" \
    "${BUS_CYCLES}" "$(per_iter ${BUS_CYCLES})"
printf "${FMT}" "Instructions" \
    "${INSTRUCTIONS}" \
    "$(per_iter ${INSTRUCTIONS})"
printf "${FMTS}" "Instr per Cycle (IPC)" \
    "${IPC}"
echo "  ------------------------------------------------------"
echo "  --- L1 Data Cache ---"
printf "${FMT}" "  Loads" \
    "${L1D_LOADS}" "$(per_iter ${L1D_LOADS})"
printf "${FMT}" "  Load misses" \
    "${L1D_MISSES}" "$(per_iter ${L1D_MISSES})"
printf "${FMTS}" "    Miss rate" \
    "${L1D_MISS_PCT}%"
printf "${FMT}" "  Stores" \
    "${L1D_STORES}" "$(per_iter ${L1D_STORES})"
echo "  --- L1 Instruction Cache ---"
printf "${FMT}" "  Loads" \
    "${L1I_LOADS}" "$(per_iter ${L1I_LOADS})"
printf "${FMT}" "  Load misses" \
    "${L1I_MISSES}" "$(per_iter ${L1I_MISSES})"
printf "${FMTS}" "    Miss rate" \
    "${L1I_MISS_PCT}%"
echo "  --- Instruction TLB ---"
printf "${FMT}" "  Load misses" \
    "${ITLB_MISSES}" \
    "$(per_iter ${ITLB_MISSES})"
echo "  --- Last Level Cache (LLC) ---"
printf "${FMT}" "  Loads" \
    "${LLC_LOADS}" "$(per_iter ${LLC_LOADS})"
printf "${FMT}" "  Load misses" \
    "${LLC_MISSES}" "$(per_iter ${LLC_MISSES})"
printf "${FMTS}" "    Load miss rate" \
    "${LLC_MISS_PCT}%"
printf "${FMT}" "  Stores" \
    "${LLC_STORES}" "$(per_iter ${LLC_STORES})"
printf "${FMT}" "  Store misses" \
    "${LLC_ST_MISSES}" \
    "$(per_iter ${LLC_ST_MISSES})"
printf "${FMTS}" "    Store miss rate" \
    "${LLC_ST_MISS_PCT}%"
echo "  --- Data TLB ---"
printf "${FMT}" "  Loads" \
    "${DTLB_LOADS}" "$(per_iter ${DTLB_LOADS})"
printf "${FMT}" "  Load misses" \
    "${DTLB_MISSES}" \
    "$(per_iter ${DTLB_MISSES})"
printf "${FMTS}" "    Load miss rate" \
    "${DTLB_MISS_PCT}%"
printf "${FMT}" "  Store misses" \
    "${DTLB_ST_MISSES}" \
    "$(per_iter ${DTLB_ST_MISSES})"
echo "  ------------------------------------------------------"
printf "${FMT}" "Branch misses" \
    "${BRANCH_MISSES}" \
    "$(per_iter ${BRANCH_MISSES})"
echo "  ------------------------------------------------------"
printf "${FMT}" "Page faults" \
    "${PAGE_FAULTS}" \
    "$(per_iter ${PAGE_FAULTS})"
printf "${FMT}" "  Minor (in page cache)" \
    "${MINOR_FAULTS}" \
    "$(per_iter ${MINOR_FAULTS})"
printf "${FMT}" "  Major (disk I/O)" \
    "${MAJOR_FAULTS}" \
    "$(per_iter ${MAJOR_FAULTS})"
printf "${FMT}" "CPU core migrations" \
    "${CPU_MIGRATIONS}" \
    "$(per_iter ${CPU_MIGRATIONS})"
printf "${FMT}" "Context switches" \
    "${CTX_SWITCHES}" \
    "$(per_iter ${CTX_SWITCHES})"
if [ "${HAVE_PROCINFO}" -eq 1 ]; then
    echo "  ------------------------------------------------------"
    printf "${FMTS}" \
        "Median iteration time" "${PI_MED_ITER} ns"
    printf "${FMTS}" \
        "Median exec time" "${PI_MED_EXEC} ns"
    printf "${FMTS}" \
        "Peak virtual memory" "${PI_VMPEAK} kB"
    printf "${FMTS}" \
        "Peak RSS (VmHWM)" "${PI_VMHWM} kB"
    printf "${FMTS}" \
        "Final RSS (VmRSS)" "${PI_VMRSS} kB"
fi
printf "${FMTS}" \
    "Executable size" "${EXE_SIZE} B"
echo "======================================================"
echo "  Results: ${RESULT_FILE}"
echo "======================================================"
echo ""

# =========================================
# CLEANUP
# =========================================

rm -f "${PERF_OUT}" "${PROCINFO_OUT}"
