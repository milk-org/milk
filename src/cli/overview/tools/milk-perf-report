            max_khz = [1000.0 / max(p["exec_p50_us"], 1.0) for p in ao_rev]
            y = np.arange(len(anames))
            ax.barh(y, max_khz, color="#2563eb", alpha=0.85)
            ax.axvline(2.0, color="#dc2626", ls="--", lw=1.2, label="Stage-2 Rate (2 kHz)")
            ax.set_xscale("log")
            ax.set_yticks(y)
            ax.set_yticklabels(anames, fontsize=7.5)
            ax.legend(loc="lower right")
        ax.set_xlabel("Unthrottled Compute Ceiling (1 / p50_exec) [kHz]")
        ax.set_title("D. Per-Daemon Unthrottled Compute Rate Ceiling", loc="left")
        ax.grid(True, axis="x", which="both", alpha=0.25)

    fig.tight_layout(rect=[0.0, 0.0, 1.0, 0.96])
    fig.savefig(os.path.join(out_dir, "compute_shm_and_calib_2x2.png"), dpi=150)
