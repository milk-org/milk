        ax.set_yticks(y)
        ax.set_yticklabels(snames, fontsize=7.6)
        ax.set_xlim(0, max(bws + [10.0]) * 1.42)
    ax.set_xlabel("Mean SHM Write Bandwidth [MB/s]")
    ax.set_title("B. Top 15 ImageStreamIO Streams by Closed-Loop Write Bandwidth", loc="left")
    ax.grid(True, axis="x", alpha=0.28)

    # Panel C: cacaosim-benchmark CPU vs CUDA
    ax = axess[1, 0]
    pairs = {}
    for r in micro_rows:
        pairs.setdefault(r["kernel"], {})[r["backend"]] = r["mean_us"]
    both = [(k, v["CPU"], v["CUDA"]) for k, v in pairs.items() if "CPU" in v and "CUDA" in v]
    if both:
        both = both[:10]
        both_rev = list(reversed(both))
        knames = [x[0][:26] for x in both_rev]
        cpuv = [x[1] for x in both_rev]
        gpuv = [x[2] for x in both_rev]
