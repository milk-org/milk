        f = compare["fused"]
        mv_mib = m.get("gpu_vram_mib", 0.0)
        fv_mib = f.get("gpu_vram_mib", 0.0)
        lines.append("### Empirical `ao3k_scexao.bench`: Modular vs Fused (`cacaosim.htsim`)")
        lines.append("")
        lines.append(
