    ax.grid(True, axis="x", alpha=0.28)

    # Panel B: SHM Stream Bandwidth
    ax = axess[0, 1]
    top_s = sorted(streams, key=lambda s: s.get("mean_mb_s", 0.0), reverse=True)[:15]
