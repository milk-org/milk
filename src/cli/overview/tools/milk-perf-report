                vram[i] + 15.0,
                i,
                f"{vram[i]:.0f} MiB | NUMA1 {n1_pct:.0f}%",
                va="center",
                fontsize=7.3,
            )
        ax.set_yticks(y)
        ax.set_yticklabels(gnames, fontsize=7.6)
