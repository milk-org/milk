        f"{h.get('shm_total_mb', 0)/1024:.0f} GiB SHM |"
    )
    if g.get("present"):
        lines.append(
            f"| GPU & Driver | {g.get('name', 'N/A')} (Driver {g.get('driver', '')}, "
            f"{g.get('vram_total_mib', 0)/1024:.1f} GiB VRAM, "
            f"{g.get('power_limit_w', 0):.0f} W cap) |"
        )
        lines.append(
            f"| GPU PCIe & NUMA Affinity | Bus `{g.get('pci_bus_id', '')}`, PCIe "
            f"Gen{g.get('pcie_gen', 0)} x{g.get('pcie_width', 0)}, "
            f"NUMA Node {g.get('numa_node', -1)} "
            f"(CPUs `{h.get('numa_node0_cpus', '')}`) |"
        )
    lines.append(
        f"| Shell Engine / Perf Counters | `{h.get('bash_version', '')}` / "
        f"`perf_event_paranoid={h.get('perf_paranoid', 99)}` |"
    )
    ov_sim_mean = ov.get("sim_cores_mean", ov.get("cpu_cores_mean", 0.0))
    ov_sim_peak = ov.get("sim_cores_peak", ov.get("cpu_cores_peak", 0.0))
    cl_sim_mean = cl_ph.get("sim_cores_mean", ov_sim_mean) if cl_ph else ov_sim_mean
    lines.append(
        f"| Overall Wall Duration & Compute | **{run.get('wall_duration_s', 0):.2f} s**; "
        f"AO/Sim mean **{ov_sim_mean:.2f}** (peak {ov_sim_peak:.2f} cores); "
        f"host mean {ov.get('cpu_cores_mean', 0):.2f} (peak {ov.get('cpu_cores_peak', 0):.2f}) |"
    )
    if cl_ph:
        cl_sim_pk = cl_ph.get("sim_cores_peak", cl_ph.get("cpu_cores_peak", 0.0))
        lines.append(
            f"| Closed-Loop Window ({cl_ph.get('duration_s', 0):.2f} s) | "
            f"AO/Sim CPU: **{cl_sim_mean:.2f} cores** (peak {cl_sim_pk:.2f}); "
            f"Host CPU: {cl_ph.get('cpu_cores_mean', 0):.2f} "
            f"({cl_ph.get('cpu_sys_share_pct', 0):.1f}% sys); "
            f"GPU SM: **{cl_ph.get('gpu_util_mean_pct', 0):.1f}%** "
            f"(peak {cl_ph.get('gpu_util_peak_pct', 0):.0f}%); "
            f"VRAM: **{cl_ph.get('gpu_vram_peak_mib', 0)/1024:.2f} GiB**; "
            f"SHM: **{cl_ph.get('shm_bw_mean_mb_s', 0):.1f} MB/s** |"
        )
    if ao_metrics:
        s_a = ao_metrics.get("star_and_atmosphere", {})
        if s_a:
            pt = max(s_a.get("physical_time_s", 1.0), 1e-6)
            we = s_a.get("wall_elapsed_s", cl_dur)
            lines.append(
                f"| Simulation Wall/Phys Ratio | `{we:.2f} s` wall for `{pt:.2f} s` phys "
                f"(`{we/pt:.2f}x` real time at {s_a.get('master_ticks_integrated', 0)} ticks) |"
            )
    lines.append("")
    lines.append("![Compute Timeline](compute_timeline_4x1.png)")
    lines.append("")

    # 2. Phase Breakdown
    lines.append("## 2. Phase-by-Phase CPU, GPU, Power, & SHM Breakdown")
    lines.append("")
    lines.append(
        "| Phase | Dur [s] | Sim Mean | Host Mean | Host Peak | Sys [%] | "
        "NUMA0 / NUMA1 | GPU SM [%] | VRAM [MiB] | Power [W] | SHM [MB/s] |"
    )
    lines.append(
        "| :--- | ---: | ---: | ---: | ---: | ---: | :---: | ---: | ---: | ---: | ---: |"
    )
    for ph in phases:
        sm = ph.get("sim_cores_mean", ph.get("cpu_cores_mean", 0.0))
        lines.append(
            f"| `{ph['id']}` | {ph['duration_s']:.2f} | {sm:.2f} | "
            f"{ph['cpu_cores_mean']:.2f} | {ph['cpu_cores_peak']:.2f} | "
            f"{ph['cpu_sys_share_pct']:.1f}% | "
            f"{ph['numa0_cores_mean']:.2f} / {ph['numa1_cores_mean']:.2f} | "
            f"{ph['gpu_util_mean_pct']:.1f}% | {ph['gpu_vram_peak_mib']:.0f} | "
            f"{ph['gpu_power_mean_w']:.1f} | {ph['shm_bw_mean_mb_s']:.1f} |"
        )
    lines.append("")
    if ov.get("cpu_cores_peak", 0.0) > max(ov_sim_peak * 2.0, 40.0):
        lines.append(
            f"> Note: `Host Mean / Host Peak` (up to {ov.get('cpu_cores_peak', 0):.1f} cores) "
            f"reflects external background jobs on this shared {h.get('nb_cpus', 0)}-CPU host; "
            f"`Sim Mean` isolates tracked `milk`/`cacao`/`cacaosim` processes "
            f"(~{cl_sim_mean:.1f} cores)."
        )
        lines.append("")
    if subsys:
        lines.append("**Closed-Loop Subsystem Rollup:**")
        lines.append("")
        lines.append(
            "| Subsystem | Active Procs | Closed-Loop CPU-s | Mean Cores | GPU VRAM [MiB] |"
        )
        lines.append("| :--- | ---: | ---: | ---: | ---: |")
        for k, v in sorted(subsys.items(), key=lambda kv: kv[1]["cpu_s"], reverse=True):
            lines.append(
                f"| {k} | {v['procs']} | {v['cpu_s']:.2f} | "
                f"{v['cpu_s']/cl_dur:.2f} | {v['vram']:.0f} |"
            )
        lines.append("")

    # 3. Real-Time Process Table
    lines.append("## 3. Closed-Loop Per-Process Telemetry (`PROCESSINFO` + OS Scheduler)")
    lines.append("")
    lines.append("![Process Breakdown](compute_process_breakdown_2x2.png)")
    lines.append("")
    lines.append(
        "| Process | Subsys | Backend | CPU% (Usr/Sys) | Thr | RSS [MB] | "
        "p50/p99/Max [us] | Jitter [us] | NUMA1% | CtxSw/it |"
    )
    lines.append(
        "| :--- | :--- | :--- | ---: | ---: | ---: | :---: | ---: | ---: | ---: |"
    )
    for p in sorted(cl_procs, key=lambda x: x.get("cl_cpu_pct", 0.0), reverse=True)[:32]:
        sub = classify_process(p["name"], p.get("cmdline", ""))
        bk = gpu_backend_label(p)
        up = 100.0 * p.get("cl_cpu_user_s", 0.0) / cl_dur
        sp = 100.0 * p.get("cl_cpu_sys_s", 0.0) / cl_dur
        tp = up + sp
        if p.get("timing_valid"):
            lat = (
                f"{p['exec_p50_us']:.0f}/{p['exec_p99_us']:.0f}/{p['exec_max_us']:.0f}"
            )
            jit = f"{p['jitter_us']:.0f}"
        else:
            lat = "-"
            jit = "-"
        lc = max(p.get("cl_loopcnt", 0), 1)
        csw = (
            f"{(p.get('cl_vol_ctxt', 0) + p.get('cl_nonvol_ctxt', 0))/lc:.2f}"
            if p.get("cl_loopcnt", 0) > 0
            else "-"
        )
        rss_mb = p.get("vmrss_peak_kb", 0) / 1024.0
        lines.append(
            f"| `{p['name']}` | {sub} | {bk} | {tp:.1f}% ({up:.0f}/{sp:.0f}) | "
            f"{p.get('threads_max', 1)} | {rss_mb:.1f} | {lat} | {jit} | "
            f"{p.get('numa_remote_pct', 0):.0f}% | {csw} |"
        )
    lines.append("")
    period_us = 1.0e6 / master_hz if master_hz > 0.0 else 0.0
    mps_active = has_cuda_mps(procs)
    slip = detect_lockstep_slip(streams)
    mps_note = " (shared via CUDA MPS)" if mps_active else ""
    slip_note = (
        f" Warning: `outarraypha` ran at {slip[0]:.0f} Hz vs `{slip[2]}` at {slip[1]:.0f} Hz "
        f"({slip[0] / max(slip[1], 0.1):.2f}x lockstep slip)."
        if slip
        else ""
    )
    lines.append(
        f"- **Pacing note**: at the measured ~{master_hz:.0f} Hz consumed master rate "
        f"(~{period_us:,.0f} us period), daemons whose p50 is far below the period sleep on"
    )
    lines.append(
        f"  `/dev/shm` semaphores between ticks; {len(gpu_procs)} active GPU processes hold "
        f"~{gpu_vram_sum_gib:.2f} GiB summed VRAM{mps_note}.{slip_note}"
    )
    lines.append("")

    # 4. Calibration & SHM
    lines.append("## 4. Calibration Breakdown, SHM Bandwidth, & Kernel Microbenchmarks")
    lines.append("")
    lines.append("![SHM and Calibration Breakdown](compute_shm_and_calib_2x2.png)")
    lines.append("")
    if any(c_stgs):
        lines.append("### Calibration Sub-Step Timings (Stage 1: 64x64 + Stage 2: 50x50)")
        lines.append("")
        lines.append(
            "| Step | Stage 1 [s] | Stage 2 [s] | Algorithm / Complexity Note |"
        )
        lines.append("| :--- | ---: | ---: | :--- |")
        s1 = c_stgs[0] if len(c_stgs) > 0 and c_stgs[0] else {}
        s2 = c_stgs[1] if len(c_stgs) > 1 and c_stgs[1] else {}
        step_defs = [
            ("takeref_s", "Reference WFS capture (60 frames)", "Stream average"),
            ("mlat_s", "Hardware latency measurement (`mlat`)", "30 poke bursts + shift-corr"),
            ("mkhadamard_s", "Hadamard basis generation (`mkHadamard`)", "CPU matrix init"),
            ("measlinresp_s", "Hadamard RM (`measlinresp`)", "4x N_H * 4 / WFS_Hz pokes"),
            ("haddec_and_masks_s", "Hadamard decode (`aolHaddec`)", "Tiled OpenMP FWHT / SGEMM"),
            ("maskextrapolate_s", "Synthetic mode extrapolation", "OpenMP + active-coord lookup"),
            ("sgemm_s", "Synthetic WFS RM (`generateRMWFS`)", "cuBLAS / OpenBLAS SGEMM"),
            ("compstrcm_svd_s", "SVD control matrix (`compstrCM`)", "GPU/LAPACK pseudo-inverse"),
        ]
        for key, title, note in step_defs:
            v1 = s1.get(key)
            v2 = s2.get(key)
            if v1 is not None or v2 is not None:
                f1 = f"{v1:.3f}" if v1 is not None else "-"
                f2 = f"{v2:.3f}" if v2 is not None else "-"
                lines.append(f"| {title} | {f1} | {f2} | {note} |")
        lines.append("")

    lines.append(
        f"### ImageStreamIO Shared-Memory Streams ({len(streams)} streams, "
        f"{total_shm_mb:.2f} MiB data, {total_shm_bw:.1f} MB/s closed-loop)"
    )
    lines.append("")
    lines.append(
        "| Stream | Type & Dims | Frame [KB] | Closed-Loop Hz | Mean BW [MB/s] | Readers |"
    )
    lines.append("| :--- | :--- | ---: | ---: | ---: | ---: |")
    for s in sorted(streams, key=lambda x: x.get("mean_mb_s", 0.0), reverse=True)[:18]:
        d = s["dims"]
        dstr = f"{d[0]}x{d[1]}x{d[2]}" if d[2] > 1 else f"{d[0]}x{d[1]}"
        lines.append(
            f"| `{s['name']}` | `{s['dtype']} {dstr}` | {s['frame_bytes']/1024:.1f} | "
            f"{s['mean_hz']:.1f} | {s['mean_mb_s']:.2f} | {s['nb_readers']} |"
        )
    lines.append("")

    if compare and compare.get("modular") and compare.get("fused"):
        m = compare["modular"]
        f = compare["fused"]
        mv_mib = m.get("gpu_vram_mib", 0.0)
        fv_mib = f.get("gpu_vram_mib", 0.0)
        lines.append("### Empirical Modular vs Fused (`cacaosim.htsim`) Comparison")
        lines.append("")
        lines.append(
            f"| Metric | Modular ({int(m['daemons'])} `csim_*` daemons) | "
            f"Fused (`csim_htsim` DAG) | Ratio |"
        )
        lines.append("| :--- | ---: | ---: | ---: |")
        lines.append(
            f"| Optical Bench Processes | {int(m['daemons'])} | {int(f['daemons'])} | "
            f"{m['daemons']/max(f['daemons'],1):.1f}x |"
        )
        lines.append(
            f"| Mean CPU Cores | {m['cpu_cores']:.2f} | {f['cpu_cores']:.2f} | "
            f"{m['cpu_cores']/max(f['cpu_cores'],0.01):.1f}x |"
        )
        lines.append(
            f"| Mean SHM Bandwidth | {m['shm_mb_s']:.1f} MB/s | {f['shm_mb_s']:.1f} MB/s | "
            f"{m['shm_mb_s']/max(f['shm_mb_s'],0.1):.1f}x |"
        )
        if mv_mib > 0.0 and fv_mib > 0.0:
            lines.append(
                f"| Peak GPU VRAM | {mv_mib:.0f} MiB | {fv_mib:.0f} MiB | "
                f"{mv_mib/max(fv_mib, 1.0):.1f}x |"
            )
        lines.append(
            f"| 10s Closed-Loop Wall Time | {m['wall_s']:.2f} s | {f['wall_s']:.2f} s | "
            f"{m['wall_s']/max(f['wall_s'],0.01):.2f}x |"
        )
        lines.append("")
        if compare.get("note"):
            lines.append(f"*{compare['note']}*")
            lines.append("")

    if ablation:
        lines.append(
            "### Suggestion 1 Benchmark: OpenMP Passive Wait + GPU-Local NUMA Node 0 "
            "Pinning"
        )
        lines.append("")
        lines.append(
            "| Config (4.0s / 8,000 ticks) | Rate [Hz] | Sim Cores | Relay Cores | "
            "NUMA1 [%] | d2 p50/p99 [us] | MVM Jit [us] | Vis SR |"
        )
        lines.append("| :--- | ---: | ---: | ---: | ---: | :---: | ---: | ---: |")
        order = [
            ("0_baseline", "Baseline (`ACTIVE`, unpinned)"),
            ("1_passive_only", "`PASSIVE` only (unpinned)"),
            ("2_numa0_only", "`NUMA Node 0` only (`ACTIVE`)"),
            ("3_both", "**Suggestion 1** (`PASSIVE` + `NUMA0`)"),
            ("400hz_base", "400 Hz Baseline (`ACTIVE`, unpinned)"),
            ("400hz_opt", "400 Hz **Suggestion 1** (`PASSIVE`+`NUMA0`)"),
        ]
        for key, lbl in order:
            r = ablation.get(key)
            if not r:
                continue
            d2s = f"{r['dichroic2_p50_us']:.0f}/{r['dichroic2_p99_us']:.0f}"
            lines.append(
                f"| {lbl} | {r['eff_master_hz']:.1f} | {r['sim_cores_mean']:.2f} | "
                f"{r['relay_cores']:.2f} | {r['avg_numa1_pct']:.1f}% | {d2s} | "
                f"{r['wfs2mvm_jitter_us']:.0f} | {r['vis_strehl_pct']:.2f}% |"
            )
        lines.append("")

    # 5. Optimization Recommendations (generated from the measured data above)
    lines.append("## 5. Ranked Bottlenecks & Code Optimization Recommendations")
    lines.append("")
    lines.append("### A. Measured Bottlenecks (ranked by estimated impact)")
    lines.append("")
    recs = build_recommendations(
        cl_procs, streams, phases, c_stgs, master_hz, avg_numa1_pct, all_procs=procs
    )
    if recs:
        for i, r in enumerate(recs, 1):
            lines.append(f"{i}. {r}")
    else:
        lines.append("No significant bottleneck detected in this run.")
    lines.append("")
    lines.append("### B. Open Feature Ideas for `milk`, `cacao`, and `cacaosim`")
    lines.append(
        "- **`milk`**: generic C stream statistics recorder (`milk-fpsexec-mem-streamstat`); "
        "optional `cudaDeviceScheduleBlockingSync` toggle for low-CPU GPU waits; Bash >= 5.3 "
        "so `@get`/`@set` avoid subshell forks."
    )
    lines.append(
        "- **`cacao`**: async/skip-disk FITS save in `mfilt` after `selfRM`; native "
        "`calib_timings.json` export; optical-gain compensation from measured on-sky `selfRM` "
        "diagonals."
    )
    lines.append(
        "- **`cacaosim`**: pinned host staging / `cudaHostRegister` for `htsim` SHM transfers; "
        "CUDA Graph capture of the fused `htsim` tick; throttle `*_long` D2H when `navg=1`."
    )
    lines.append("")

    rep_path = os.path.join(out_dir, "COMPUTE_REPORT.md")
    with open(rep_path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    return {
        "total_shm_mb": total_shm_mb,
        "total_shm_bw_mb_s": total_shm_bw,
        "subsystems": subsys,
        "report_md": rep_path,
    }


def main():
    mono = check_help_early(sys.argv[1:])
    ap = argparse.ArgumentParser(
        prog="milk-perf-report",
        description=DESC_ONE,
    )
    ap.add_argument("-t", "--telemetry", required=True, help="compute_telemetry.json path")
    ap.add_argument("-c", "--csv", default="", help="compute_timeseries.csv path")
    ap.add_argument("-o", "--outdir", default="", help="Output directory")
    ap.add_argument("--ao-metrics", default="", help="Optional ao3k_scexao_metrics.json path")
    ap.add_argument("--calib-stg1", default="", help="Optional Stage-1 calib_timings.json")
    ap.add_argument("--calib-stg2", default="", help="Optional Stage-2 calib_timings.json")
    ap.add_argument("--microbench", default="", help="Optional cacaosim-benchmark output text")
    ap.add_argument("--compare-modes", default="", help="Optional modular vs fused JSON")
    ap.add_argument("--ablation", default="", help="Optional suggestion1_ablation.json")
    ap.add_argument("-hm", "--help-mono", action="store_true", help="Monochrome help")
    args = ap.parse_args()
    _ = mono

    out_dir = args.outdir or os.path.dirname(os.path.abspath(args.telemetry)) or "."
    os.makedirs(out_dir, exist_ok=True)

    telem = load_opt_json(args.telemetry)
    if not telem:
        sys.exit(f"milk-perf-report: cannot load telemetry JSON '{args.telemetry}'")

    csv_path = args.csv or os.path.join(os.path.dirname(args.telemetry), "compute_timeseries.csv")
    ts_rows = load_csv(csv_path)
    ao_metrics = load_opt_json(args.ao_metrics)
    c_stg1 = load_opt_json(args.calib_stg1)
    c_stg2 = load_opt_json(args.calib_stg2)
    c_stgs = [c_stg1, c_stg2]
    micro_rows = parse_microbench(args.microbench)
    compare = load_opt_json(args.compare_modes)
    abl_path = args.ablation or os.path.join(out_dir, "suggestion1_ablation.json")
    ablation = load_opt_json(abl_path)

    procs = dedup_processes(telem.get("processes", []))
    cl_procs = [p for p in procs if p.get("cl_cpu_s", 0.0) > 0.0 or p.get("cl_loopcnt", 0) > 0]
    if not cl_procs:
        cl_procs = procs
    streams = telem.get("streams", [])

    render_plots(out_dir, telem, ts_rows, procs, cl_procs, streams, c_stgs, micro_rows, compare)
    extra = compile_markdown(
        out_dir,
        telem,
        ts_rows,
        procs,
        cl_procs,
        streams,
        c_stgs,
        micro_rows,
        compare,
        ao_metrics,
        ablation,
    )

    perf_out = {
        "host": telem.get("host", {}),
        "gpu": telem.get("gpu", {}),
        "run": telem.get("run", {}),
        "phases": telem.get("phases", []),
        "summary": extra,
        "microbenchmarks": micro_rows,
        "calib_stage1": c_stg1,
        "calib_stage2": c_stg2,
        "modular_vs_fused": compare,
        "suggestion1_ablation": ablation,
    }
    pjson = os.path.join(out_dir, "compute_perf_metrics.json")
    with open(pjson, "w", encoding="utf-8") as fh:
        json.dump(perf_out, fh, indent=2)
        fh.write("\n")

    print(f"[milk-perf-report] Wrote {extra['report_md']} and 3 compute figures.")


if __name__ == "__main__":
    main()
