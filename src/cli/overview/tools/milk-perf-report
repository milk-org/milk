def infer_master_hz(streams):
    """Effective master tick rate: consumed fastest WFS stream if active, else outarraypha."""
    by_name = {s.get("name", ""): s for s in streams}
    for cand in ("csim_wfs_vis", "csim_wfs", "outarraypha"):
        st = by_name.get(cand)
        if st and st.get("mean_hz", 0.0) > 0.0:
            return st["mean_hz"]
    rates = [s.get("mean_hz", 0.0) for s in streams]
    return max(rates) if rates else 0.0


def detect_lockstep_slip(streams):
    """Return (pha_hz, cons_hz, cons_name) if atmosphere produces >10% faster than consumed."""
    by_name = {s.get("name", ""): s for s in streams}
    pha = by_name.get("outarraypha")
    if not pha or pha.get("mean_hz", 0.0) <= 0.0:
        return None
    for cand in ("csim_wfs_vis", "csim_wfs"):
        cons = by_name.get(cand)
        if cons and cons.get("mean_hz", 0.0) > 0.0:
            pha_hz = pha["mean_hz"]
            cons_hz = cons["mean_hz"]
            if pha_hz > 1.10 * cons_hz:
                return (pha_hz, cons_hz, cand)
            return None
    return None


def build_recommendations(cl_procs, streams, phases, c_stgs, master_hz, avg_numa1_pct, all_procs=None):
    """Rank optimization opportunities from measured closed-loop and calibration data."""
    recs = []
    period_us = 1.0e6 / master_hz if master_hz > 0.0 else 0.0
    procs_for_mps = all_procs if all_procs is not None else cl_procs
    mps_active = has_cuda_mps(procs_for_mps)

    # (0) Turbulence lockstep slip check (producer outrunning optical bench consumer)
    slip = detect_lockstep_slip(streams)
    if slip:
        pha_hz, cons_hz, cons_name = slip
        ratio = pha_hz / max(cons_hz, 0.1)
        recs.append((
            120.0 * min(ratio, 4.0),
            f"**Turbulence lockstep slip (`outarraypha` at {pha_hz:.0f} Hz vs `{cons_name}` at "
            f"{cons_hz:.0f} Hz, {ratio:.2f}x)**: unconsumed phase screens are being dropped and "
            "effective wind speed is inflated. Lock `csim_atmturb` (`triggermode=3`) to "
            f"`{cons_name}` for exact 1:1 lockstep.",
        ))

    # (a) Serial latency ceiling: slowest synchronous per-tick compute unit bounds lockstep rate
    max_lc = max((p.get("cl_loopcnt", 0) for p in cl_procs), default=0)
    timed_sync = [
        p
        for p in cl_procs
        if p.get("timing_valid")
        and p.get("exec_p50_us", 0) > 0
        and not is_async_daemon(p, max_lc)
    ]
    if timed_sync and period_us > 0.0:
        slow = max(timed_sync, key=lambda p: p.get("exec_p50_us", 0.0))
        p50 = slow["exec_p50_us"]
        p99 = slow.get("exec_p99_us", p50)
        ceil_hz = 1.0e6 / p50
        util = 100.0 * p50 / period_us
        recs.append((
            util,
            f"**Rate ceiling set by `{slow['name']}`** (p50/p99 = {p50:.0f}/{p99:.0f} us): "
            f"the lockstep loop cannot exceed ~{ceil_hz:.0f} Hz wall-clock "
            f"({util:.0f}% of the {period_us:.0f} us period at {master_hz:.0f} Hz). "
            "Profile its per-tick stages (Nsight Systems or per-node timers) to raise it.",
        ))

    # Separate diagnostic for heavy async background trainers (never claim they gate lockstep)
    async_heavy = [
        p
        for p in cl_procs
        if p.get("timing_valid")
        and is_async_daemon(p, max_lc)
        and p.get("exec_p50_us", 0.0) > 100000.0
    ]
    for p in sorted(async_heavy, key=lambda x: x.get("exec_p50_us", 0.0), reverse=True)[:2]:
        p50_ms = p["exec_p50_us"] / 1000.0
        p99_ms = p.get("exec_p99_us", p["exec_p50_us"]) / 1000.0
        recs.append((
            min(40.0, p50_ms / 25.0),
            f"**Async background solver `{p['name']}` update time = {p50_ms:.0f} ms p50 "
            f"({p99_ms:.0f} ms p99, {p.get('cl_loopcnt', 0)} updates)**: runs asynchronously "
            "(does not block the lockstep rate); tune `updateperiod`, `blocksize`, or BLAS threads "
            "if faster filter adaptation is needed.",
        ))

    # (b) Largest CPU consumers
    for p in sorted(cl_procs, key=lambda x: x.get("cl_cpu_pct", 0.0), reverse=True)[:3]:
        pct = p.get("cl_cpu_pct", 0.0)
        if pct < 10.0:
            continue
        sub = classify_process(p["name"], p.get("cmdline", ""))
        thr = p.get("threads_max", 1)
        hint = "consider moving its per-frame work onto the GPU or fusing it in-process"
        if sub == "Telemetry":
            hint = ("use in-DAG statistics (`csim_htsim.wfstat_enable`) instead of a separate "
                    "SHM consumer")
        elif sub == "PF Trainer":
            hint = "async background solver; tune `updateperiod` or `PF_MKTHREADS` to reduce CPU"
        elif p.get("gpu_vram_peak_mib", 0.0) > 1.0:
            hint = ("GPU-backed, so this is host-side launch/sync/D2H time; CUDA Graph capture "
                    "or fewer per-tick host transfers reduce it")
        elif thr >= 4 and pct > 150.0:
            hint = "OpenMP team likely spin-waiting; check `.procinfo.OMPwait` / thread count"
        tlabel = f"{thr} thread" + ("" if thr == 1 else "s")
        recs.append((
            pct * 0.5,
            f"**`{p['name']}` uses {pct:.1f}% CPU** ({sub}, {tlabel}): {hint}.",
        ))

    # (c) Shared-memory streams written every tick but never read
    unread = [s for s in streams if s.get("nb_readers", 1) == 0 and s.get("mean_mb_s", 0) > 20]
    if unread:
        tot = sum(s["mean_mb_s"] for s in unread)
        names = ", ".join(f"`{s['name']}`" for s in sorted(
            unread, key=lambda x: x["mean_mb_s"], reverse=True)[:6])
        recs.append((
            tot / 10.0,
            f"**{len(unread)} SHM streams are written but have no readers** "
            f"({tot:.0f} MB/s total: {names}). Disable those outputs when not needed.",
        ))

    # (d) GPU context overhead (skip MPS recommendation when CUDA MPS is already active)
    gpu = [
        p
        for p in cl_procs
        if p.get("gpu_vram_peak_mib", 0.0) > 1.0
        and classify_process(p["name"], p.get("cmdline", "")) != "GPU MPS"
    ]
    if len(gpu) >= 3 and not mps_active:
        vram = sum(p["gpu_vram_peak_mib"] for p in gpu) / 1024.0
        recs.append((
            10.0 * len(gpu),
            f"**{len(gpu)} separate CUDA contexts hold {vram:.2f} GiB VRAM**, mostly per-process "
            "context overhead and GPU time-slicing; enable CUDA MPS (`CACAO_CUDA_MPS=1`) or "
            "merge per-stage MVM units.",
        ))

    # (e) Cross-socket NUMA execution
    if avg_numa1_pct > 5.0:
        recs.append((
            avg_numa1_pct,
            f"**Compute daemons average {avg_numa1_pct:.0f}% remote-NUMA residency**: pin to "
            "the GPU-local node (`.procinfo.numanode=-2`).",
        ))

    # (f) Calibration and long phases
    calib = {}
    for st in c_stgs:
        for k, v in (st or {}).items():
            if k.endswith("_s") and isinstance(v, (int, float)):
                calib[k] = calib.get(k, 0.0) + float(v)
    long_ph = [ph for ph in phases if ph.get("id") not in ("overall",)
               and ph.get("duration_s", 0.0) > 60.0 and "closed_loop" not in ph.get("id", "")]
    if calib:
        top_k, top_v = max(calib.items(), key=lambda kv: kv[1])
        tot = sum(calib.values())
        if top_v > 0.3 * tot and top_v > 10.0:
            recs.append((
                top_v / 5.0,
                f"**Calibration is dominated by `{top_k[:-2]}`** ({top_v:.1f} s of {tot:.1f} s "
                "summed over stages); it scales with the wall-clock rate, so raise the master "
                "rate or reduce frames/cycles.",
            ))
    for ph in long_ph:
        pid = ph.get("id", "")
        sim_c = ph.get("sim_cores_mean", 0.0)
        host_c = ph.get("cpu_cores_mean", 0.0)
        if pid in ("ao_report", "tlm_analysis", "calib_2wfs1dm") or sim_c < 0.15:
            recs.append((
                ph["duration_s"] / 5.0,
                f"**Offline post-processing phase `{pid}` takes {ph['duration_s']:.0f} s** "
                f"(mean {host_c:.2f} host cores, {sim_c:.2f} sim cores); parallelize figure/video "
                "rendering or OpenMP workers.",
            ))
        else:
            recs.append((
                ph["duration_s"] / 5.0,
                f"**Phase `{pid}` takes {ph['duration_s']:.0f} s** at {master_hz:.0f} Hz "
                f"(mean {sim_c:.2f} sim cores); it is wall-rate bound and shrinks proportionally "
                "at higher pacing.",
            ))

    recs.sort(key=lambda r: r[0], reverse=True)
    return [txt for _, txt in recs]


def compile_markdown(
    out_dir,
    telem,
    ts_rows,
    procs,
    cl_procs,
    streams,
    c_stgs,
    micro_rows,
    compare,
    ao_metrics,
    ablation=None,
):
    h = telem.get("host", {})
    g = telem.get("gpu", {})
    run = telem.get("run", {})
    phases = telem.get("phases", [])
    ov = next((p for p in phases if p.get("id") == "overall"), {})
    cl_ph = next(
        (p for p in phases if "closed_loop" in p.get("id", "") and "warmup" not in p["id"]),
        {},
    )
    cl_dur = max(run.get("closed_loop_duration_s", 1.0), 0.1)

    total_shm_mb = sum(s.get("frame_bytes", 0) for s in streams) / (1024.0 * 1024.0)
    total_shm_bw = sum(s.get("mean_mb_s", 0.0) for s in streams)
    subsys = {}
    for p in cl_procs:
        sub = classify_process(p["name"], p.get("cmdline", ""))
        subsys.setdefault(sub, {"procs": 0, "cpu_s": 0.0, "vram": 0.0})
        subsys[sub]["procs"] += 1
        subsys[sub]["cpu_s"] += p.get("cl_cpu_s", 0.0)
        subsys[sub]["vram"] += p.get("gpu_vram_peak_mib", 0.0)
    gpu_procs = [p for p in cl_procs if p.get("gpu_vram_peak_mib", 0.0) > 1.0]
    gpu_vram_sum_gib = sum(p.get("gpu_vram_peak_mib", 0.0) for p in gpu_procs) / 1024.0
    numa_procs = [
        p
        for p in cl_procs
        if (p.get("numa0_hits", 0) + p.get("numa1_hits", 0)) > 0
        and classify_process(p["name"], p.get("cmdline", "")) != "Orchestration"
    ]
    avg_numa1_pct = (
        sum(p.get("numa_remote_pct", 0.0) for p in numa_procs) / len(numa_procs)
        if numa_procs
        else 0.0
    )

    master_hz = infer_master_hz(streams)

    lines = []
    lines.append("# Compute Performance & Optimization Report: Subaru AO3k + SCExAO Simulation")
    lines.append("")
    lines.append(
