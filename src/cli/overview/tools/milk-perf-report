def check_help_early(argv):
    for a in argv:
        if a in ("-h1", "--help-oneline"):
            print(DESC_ONE)
            sys.exit(0)
        if a in ("-h2", "--help-description"):
            print(DESC_LONG)
            sys.exit(0)
        if a in ("-hm", "--help-mono"):
            return True
    return False


def classify_process(name, cmdline=""):
    nl = name.lower()
    if "cuda-mps" in nl or "cuda-mps" in cmdline.lower():
        return "GPU MPS"
    if nl.startswith("tlog_") or "streamfitslog" in cmdline.lower():
        return "Telemetry"
    if nl.startswith("csim_") or "cacaosim" in cmdline.lower():
        if nl == "csim_wfstat":
            return "Telemetry"
        if nl in ("csim_atmturb",):
            return "Atmosphere"
        return "Optical Bench"
    if any(k in nl for k in ("mkeofpf", "mkarpf", "mkpf")):
        return "PF Trainer"
    if nl.startswith("dmch2disp"):
        return "AO Control"
    if any(
        k in nl
        for k in (
            "acquwfs",
            "wfs2cmodeval",
            "mfilt",
            "mvalc2dm",
            "mctrlstats",
            "applyeofpf",
            "applyarpf",
            "zpo-",
            "zpo_",
        )
    ):
        return "AO Control"
    if any(k in nl for k in ("mlat", "measlinresp", "compstrcm", "cacao")):
        return "Calibration"
    if "milk-script" in cmdline or "milk-fps" in cmdline or "milk-stream" in cmdline:
        return "Orchestration"
    if "cacao-cli" in nl or "cacao-cli" in cmdline:
        return "Calibration"
    return "Other"


def is_async_daemon(proc, max_cl_loops=0):
    """Return True for background/async trainers that do not gate the lockstep tick."""
    nl = proc.get("name", "").lower()
    if any(k in nl for k in ("mkeofpf", "mkarpf", "mkpf")):
        return True
    lc = proc.get("cl_loopcnt", 0)
    if max_cl_loops >= 200 and 0 < lc < max(50, int(0.05 * max_cl_loops)):
        return True
    return False


def has_cuda_mps(procs):
    """Return True if a CUDA MPS server process was observed during the run."""
    for p in procs:
        nl = p.get("name", "").lower()
        cl = p.get("cmdline", "").lower()
        if "cuda-mps" in nl or "cuda-mps" in cl:
            return True
    return False


def dedup_processes(procs):
    by_pid = {}
    no_pid = []
    for p in procs:
        pid = int(p.get("pid", 0) or 0)
        if pid <= 0:
            no_pid.append(dict(p))
            continue
        cur = by_pid.get(pid)
        if cur is None:
            by_pid[pid] = dict(p)
            continue
        # Prefer canonical PROCESSINFO name over generic kernel comm or cmdline basename
        prefer_new = bool(p.get("has_pinfo")) and not bool(cur.get("has_pinfo"))
        if not prefer_new and bool(p.get("has_pinfo")) == bool(cur.get("has_pinfo")):
            cname = cur.get("name", "")
            nname = p.get("name", "")
            if cname.startswith("milk-fpsexec") and not nname.startswith("milk-fpsexec"):
                prefer_new = True
        merged = dict(p if prefer_new else cur)
        other = cur if prefer_new else p
        for mxk in (
            "gpu_vram_peak_mib",
            "vmrss_peak_kb",
            "threads_max",
            "cl_cpu_user_s",
            "cl_cpu_sys_s",
            "cl_cpu_s",
            "cl_cpu_pct",
            "cl_vol_ctxt",
            "cl_nonvol_ctxt",
            "cl_loopcnt",
            "cpu_total_s",
            "numa0_hits",
            "numa1_hits",
        ):
            merged[mxk] = max(merged.get(mxk, 0), other.get(mxk, 0))
        tot_n = merged.get("numa0_hits", 0) + merged.get("numa1_hits", 0)
        if tot_n > 0:
            merged["numa_remote_pct"] = 100.0 * merged.get("numa1_hits", 0) / tot_n
        if not merged.get("timing_valid") and other.get("timing_valid"):
            for tk in (
                "timing_valid",
                "exec_samples",
                "exec_p50_us",
                "exec_p95_us",
                "exec_p99_us",
                "exec_max_us",
                "jitter_us",
            ):
                if tk in other:
                    merged[tk] = other[tk]
        if not merged.get("cmdline") and other.get("cmdline"):
            merged["cmdline"] = other["cmdline"]
        by_pid[pid] = merged
    return list(by_pid.values()) + no_pid


def parse_microbench(path):
    rows = []
    if not path or not os.path.isfile(path):
        return rows
    pat = re.compile(
        r"^\s*(.+?)\s*\|\s*(CPU|CUDA)\s*\|\s*([0-9.]+)\s*\|\s*([0-9.]+)\s*\|\s*"
        r"([0-9.]+)\s*\|\s*([0-9.]+)\s*kHz"
    )
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            m = pat.match(line)
            if m:
                rows.append(
                    {
                        "kernel": m.group(1).strip(),
                        "backend": m.group(2),
                        "mean_us": float(m.group(3)),
                        "p50_us": float(m.group(4)),
                        "p99_us": float(m.group(5)),
                        "khz": float(m.group(6)),
                    }
                )
    return rows


def load_csv(path):
    cols = []
    if not path or not os.path.isfile(path):
        return cols
    with open(path, "r", encoding="utf-8") as fh:
        rdr = csv.DictReader(fh)
        for r in rdr:
            row = {}
            for k, v in r.items():
                if k == "phase":
                    row[k] = v
                else:
                    try:
                        row[k] = float(v)
                    except (TypeError, ValueError):
                        row[k] = 0.0
            cols.append(row)
    return cols


def load_opt_json(path):
    if not path or not os.path.isfile(path):
        return None
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def gpu_backend_label(proc):
    if proc.get("gpu_vram_peak_mib", 0.0) > 1.0:
        return f"CUDA ({proc['gpu_vram_peak_mib']:.0f} MiB)"
    nl = proc.get("name", "").lower()
    if any(k in nl for k in ("wfs2cmodeval", "mvalc2dm", "zpo-", "zpo_")):
        return "CPU (BLAS)"
    if any(k in nl for k in ("compstrcm", "wfs_", "psf_", "coro")):
        return "CUDA/CPU"
    return "CPU"


def render_plots(out_dir, telem, ts_rows, procs, cl_procs, streams, c_stgs, micro_rows, compare):
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    import numpy as np

    plt.rcParams.update(
        {
            "font.size": 9,
            "axes.titlesize": 10,
            "axes.labelsize": 9,
            "legend.fontsize": 8,
            "figure.facecolor": "white",
        }
    )

    phases = [p for p in telem.get("phases", []) if p.get("id") != "overall"]

    # ------------------------------------------------------------------
    # Figure 1: 4x1 Wall-Clock Timeline across Phases
    # ------------------------------------------------------------------
    if ts_rows:
        t = np.array([r["t_rel_s"] for r in ts_rows], dtype=float)
        tot_c = np.array([r["total_cores"] for r in ts_rows], dtype=float)
        sim_c = np.array([r.get("sim_cores", r["total_cores"]) for r in ts_rows], dtype=float)
        usr_c = np.array([r["user_cores"] for r in ts_rows], dtype=float)
        sys_c = np.array([r["sys_cores"] for r in ts_rows], dtype=float)
        n0_c = np.array([r["numa0_cores"] for r in ts_rows], dtype=float)
        n1_c = np.array([r["numa1_cores"] for r in ts_rows], dtype=float)
        g_sm = np.array([r["gpu_util_pct"] for r in ts_rows], dtype=float)
        g_mem = np.array([r["gpu_mem_util_pct"] for r in ts_rows], dtype=float)
        g_vram = np.array([r["gpu_vram_mib"] for r in ts_rows], dtype=float)
        g_pwr = np.array([r["gpu_power_w"] for r in ts_rows], dtype=float)
        g_clk = np.array([r["gpu_sm_mhz"] for r in ts_rows], dtype=float)
        shm_bw = np.array([r["shm_bw_mb_s"] for r in ts_rows], dtype=float)
        act_p = np.array([r["active_procs"] for r in ts_rows], dtype=float)

        fig, axes = plt.subplots(4, 1, figsize=(13.5, 11.2), sharex=True, dpi=150)
        fig.suptitle(
            "AO3k + SCExAO Compute Timeline: CPU, NUMA, GPU, Power, & SHM Bandwidth",
            fontsize=12.5,
            fontweight="bold",
            y=0.988,
        )

        t_span = max(float(t[-1] - t[0]), 1.0)
        last_lbl_x = -1e9
        lbl_row = 0
        for ax in axes:
            for idx, ph in enumerate(phases):
                ts0 = ph.get("t_start_s", 0.0)
                ts1 = ph.get("t_end_s", ts0)
                if ts1 <= ts0:
                    continue
                pid = ph.get("id", "")
                if "closed_loop" in pid and "warmup" not in pid:
                    ax.axvspan(ts0, ts1, color="#dcfce7", alpha=0.55, zorder=0)
                elif "selfrm" in pid:
                    ax.axvspan(ts0, ts1, color="#fef3c7", alpha=0.55, zorder=0)
                elif idx > 0:
                    ax.axvline(ts0, color="#94a3b8", ls=":", lw=0.9, zorder=1)
                if ax is axes[0] and (ts1 - ts0) >= max(1.5, 0.015 * t_span):
                    xm = 0.5 * (ts0 + ts1)
                    if (xm - last_lbl_x) < 0.075 * t_span:
                        lbl_row = 1 - lbl_row
                    else:
                        lbl_row = 0
                    last_lbl_x = xm
                    yy = 0.96 if lbl_row == 0 else 0.78
                    lbl = pid.replace("_", "\n")
                    ax.text(
                        xm,
                        yy,
                        lbl,
                        transform=ax.get_xaxis_transform(),
                        ha="center",
                        va="top",
                        fontsize=7.0,
                        color="#334155",
                        bbox=dict(boxstyle="round,pad=0.14", fc="white", ec="#cbd5e1", alpha=0.85),
                    )
            ax.grid(True, alpha=0.28)

        ax0 = axes[0]
        ext_spike = float(np.max(tot_c)) > max(float(np.max(sim_c)) * 2.0, 25.0)
        if ext_spike:
            ax0.plot(t, sim_c, color="#1d4ed8", lw=2.0, zorder=5, label="AO/Sim Stack Cores")
            ax0_r = ax0.twinx()
            ax0_r.plot(
                t,
                tot_c,
                color="#64748b",
                lw=1.1,
                alpha=0.75,
                label="Host Total (w/ external)",
            )
            ax0_r.plot(
                t, n0_c, color="#059669", lw=0.9, ls="--", alpha=0.75, label="Host NUMA 0"
            )
            ax0_r.plot(
                t, n1_c, color="#9333ea", lw=0.9, ls=":", alpha=0.75, label="Host NUMA 1"
            )
            ax0.set_ylabel("AO/Sim Cores", color="#1d4ed8")
            ax0_r.set_ylabel("Host Cores (512 CPUs)", color="#64748b")
            ax0.set_ylim(0.0, max(float(np.max(sim_c)) * 1.45, 4.0))
            ax0_r.set_ylim(0.0, max(float(np.max(tot_c)) * 1.30, 20.0))
            l0, lb0 = ax0.get_legend_handles_labels()
            lr, lbr = ax0_r.get_legend_handles_labels()
            ax0.legend(
                l0 + lr,
                lb0 + lbr,
                bbox_to_anchor=(0.5, 1.01),
                loc="lower center",
                ncol=4,
                framealpha=0.92,
            )
        else:
            ax0.plot(t, sim_c, color="#1d4ed8", lw=2.0, zorder=5, label="AO/Sim Stack Cores")
            ax0.plot(t, tot_c, color="#0f172a", lw=1.2, alpha=0.85, label="Host Total Cores")
            ax0.plot(t, usr_c, color="#2563eb", lw=1.0, alpha=0.75, label="User Cores")
            ax0.plot(t, sys_c, color="#dc2626", lw=1.0, label="Kernel/Sys Cores")
            ax0.plot(t, n0_c, color="#059669", lw=1.0, ls="--", alpha=0.8, label="NUMA 0")
            ax0.plot(t, n1_c, color="#9333ea", lw=1.0, ls=":", alpha=0.8, label="NUMA 1")
            ax0.set_ylabel("CPU Cores")
            ax0.set_ylim(0.0, max(float(np.max(tot_c)) * 1.42, 4.0))
            ax0.legend(
                bbox_to_anchor=(0.5, 1.01),
                loc="lower center",
                ncol=6,
                framealpha=0.92,
            )
        ax0.set_title(
            "AO/Sim vs System CPU Core Consumption & NUMA Split (512 Logical CPUs)",
            loc="left",
            pad=26,
        )

        ax1 = axes[1]
        ax1.plot(t, g_sm, color="#16a34a", lw=1.6, label="GPU SM Util [%]")
        ax1.plot(t, g_mem, color="#0284c7", lw=1.2, label="GPU Mem Ctrl [%]")
        ax1_r = ax1.twinx()
        ax1_r.plot(t, g_vram / 1024.0, color="#7c3aed", lw=1.4, ls="--", label="VRAM Used [GiB]")
        ax1.set_ylabel("Utilization [%]")
        ax1_r.set_ylabel("VRAM [GiB]", color="#7c3aed")
        ax1.set_title("NVIDIA RTX PRO 6000 Blackwell Utilization & Allocated VRAM", loc="left")
        ax1.set_ylim(-2.0, max(105.0, float(np.max(g_sm)) * 1.15))
        ax1_r.set_ylim(0.0, max(float(np.max(g_vram)) / 1024.0 * 1.25, 4.0))
        l1, lb1 = ax1.get_legend_handles_labels()
        l2, lb2 = ax1_r.get_legend_handles_labels()
        ax1.legend(l1 + l2, lb1 + lb2, loc="upper left", ncol=3, framealpha=0.90)

        ax2 = axes[2]
        ax2.plot(t, g_pwr, color="#ea580c", lw=1.6, label="GPU Power Draw [W]")
        ax2_r = ax2.twinx()
        ax2_r.plot(t, g_clk, color="#475569", lw=1.2, ls="-.", label="GPU SM Clock [MHz]")
        ax2.set_ylabel("Power [W]")
        ax2_r.set_ylabel("SM Clock [MHz]", color="#475569")
        ax2.set_title("GPU Board Power & Boost Clock State", loc="left")
        ax2.set_ylim(0.0, max(float(np.max(g_pwr)) * 1.25, 100.0))
        ax2_r.set_ylim(0.0, max(float(np.max(g_clk)) * 1.20, 1500.0))
        l1, lb1 = ax2.get_legend_handles_labels()
        l2, lb2 = ax2_r.get_legend_handles_labels()
        ax2.legend(l1 + l2, lb1 + lb2, loc="upper left", ncol=2, framealpha=0.90)

        ax3 = axes[3]
        ax3.plot(t, shm_bw, color="#0d9488", lw=1.5, label="Aggregate SHM Write [MB/s]")
        ax3_r = ax3.twinx()
        ax3_r.plot(t, act_p, color="#be185d", lw=1.2, ls="--", label="Active Daemons/Procs")
        ax3.set_ylabel("SHM BW [MB/s]")
        ax3_r.set_ylabel("Active Procs", color="#be185d")
        ax3.set_xlabel("Wall-Clock Time [s]")
        ax3.set_title("ImageStreamIO SHM Aggregate Write Rate & Active Processes", loc="left")
        ax3.set_ylim(0.0, max(float(np.max(shm_bw)) * 1.20, 50.0))
        ax3_r.set_ylim(0.0, max(float(np.max(act_p)) * 1.20, 10.0))
        l1, lb1 = ax3.get_legend_handles_labels()
        l2, lb2 = ax3_r.get_legend_handles_labels()
        ax3.legend(l1 + l2, lb1 + lb2, loc="upper left", ncol=2, framealpha=0.90)

        fig.tight_layout(rect=[0.0, 0.0, 1.0, 0.96])
        fig.savefig(os.path.join(out_dir, "compute_timeline_4x1.png"), dpi=150, pil_kwargs={"compress_level": 1})
        plt.close(fig)

    # ------------------------------------------------------------------
    # Figure 2: 2x2 Closed-Loop Per-Process CPU, Latency, VRAM/NUMA, Ctxt
    # ------------------------------------------------------------------
    fig, axess = plt.subplots(2, 2, figsize=(14.0, 9.8), dpi=150)
    fig.suptitle(
        "Closed-Loop Real-Time Compute Profile: CPU, Latency Jitter, VRAM/NUMA, & Context Switches",
        fontsize=12.5,
        fontweight="bold",
        y=0.985,
    )

    cl_dur = max(telem.get("run", {}).get("closed_loop_duration_s", 1.0), 0.1)
    top_p = sorted(cl_procs, key=lambda p: p.get("cl_cpu_pct", 0.0), reverse=True)[:18]
    top_p_rev = list(reversed(top_p))

