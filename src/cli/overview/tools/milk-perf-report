        for i, (mv, fv) in enumerate(zip(mvals, fvals)):
            mf = f"{mv:.0f}" if mv >= 20 else f"{mv:.2f}" if mv < 2 else f"{mv:.1f}"
            ff = f"{fv:.0f}" if fv >= 20 else f"{fv:.2f}" if fv < 2 else f"{fv:.1f}"
            ax.text(i - w / 2, mv * 1.15, mf, ha="center", va="bottom", fontsize=7.5)
            ax.text(i + w / 2, fv * 1.15, ff, ha="center", va="bottom", fontsize=7.5)
        ax.set_ylabel("Value (log scale)")
        ax.set_title("D. ao3k_scexao.bench Open-Loop: Modular vs Fused Architecture", loc="left")
        ax.legend(loc="upper left", framealpha=0.92)
        ax.grid(True, axis="y", which="both", alpha=0.28)
    else:
        # Show Duty Cycle & Real-Time Ceiling of top AO daemons
        ao_t = [
            p
            for p in cl_procs
            if p.get("timing_valid") and classify_process(p["name"], p.get("cmdline", ""))
            in ("AO Control", "Optical Bench")
