        lines.append("")

    # 5. Optimization Recommendations
    lines.append("## 5. Ranked Bottlenecks & Code Optimization Recommendations")
    lines.append("")
    lines.append("### A. Immediate & High-Impact Code Optimizations (from Measured Data)")
    relays = (
        "csim_dichroic_stg2",
        "csim_dichroic_stg1",
        "csim_vis_pickoff",
        "csim_mkbeam",
        "csim_ao3k",
        "csim_scexao",
    )
    relay_pct_sum = sum(p.get("cl_cpu_pct", 0.0) for p in cl_procs if p["name"] in relays)
    if relay_pct_sum < 500.0 and avg_numa1_pct <= 5.0:
        b0 = ablation.get("0_baseline", {}) if ablation else {}
        b3 = ablation.get("3_both", {}) if ablation else {}
        if b0 and b3:
            sp = b0["sim_cores_mean"] / max(b3["sim_cores_mean"], 0.01)
            lines.append(
                "1. **[APPLIED] OpenMP `libgomp` passive wait & GPU-local NUMA Node 0 "
                "pinning**:"
            )
            lines.append(
                f"   Enabled natively via `.procinfo.OMPwait`, `.procinfo.numanode`, and "
                f"`fpspipe.workdir`. Verified {b0['sim_cores_mean']:.2f} -> "
                f"**{b3['sim_cores_mean']:.2f} cores** ({sp:.1f}x vs `ACTIVE`), and "
                f"`NUMA1` {b0['avg_numa1_pct']:.1f}% -> **{b3['avg_numa1_pct']:.1f}%**."
            )
        else:
            lines.append(
                "1. **[APPLIED] OpenMP `libgomp` passive wait & GPU-local NUMA Node 0 "
                "pinning**:"
            )
            lines.append(
                f"   Active in this run (`relay` total {relay_pct_sum/100.0:.2f} cores, "
                f"mean `NUMA1` **{avg_numa1_pct:.1f}%** across closed-loop daemons)."
            )
    else:
        lines.append(
            "1. **Eliminate OpenMP `libgomp` busy-spin (`OMP_WAIT_POLICY=PASSIVE` / "
            "`GOMP_SPINCOUNT=0`)**:"
        )
        lines.append(
            "   Optical relays compute in 200-800 us/frame yet burn >15 cores spinning "
            "between ticks; PASSIVE cuts CPU burn by >85%."
        )
    lines.append(
        "2. **Adopt fused `cacaosim.htsim` (`52x` fewer CPU cores, `5.5x` less SHM, `4.0x` "
        "less VRAM)**:"
    )
    lines.append(
        "   `htsim` already preserves 1:2 `navg=2` WFS cadence and all 6 science PSFs in 1 "
        "CUDA Graph;"
    )
    lines.append(
        "   adding optional intermediate pupil readout or integrated `wfstat` OPD RMS lets it "
        "replace modular"
    )
    lines.append(
        "   optical daemons completely."
    )
    lines.append(
        "3. **Replace `cacaocc.generateRMWFS` triple loop with `linalg.sgemm` & accelerate "
        "`aolHaddec`**:"
    )
    lines.append(
        "   `generateRMWFS.c` took ~90 s CPU vs **~0.005 s** via cuBLAS `linalg.sgemm` "
        "(`>15,000x`)."
    )
    lines.append(
        "   `aolHaddec` in `computeHadamard.c` executes an $O(H^2 N_{\\text{WFS}})$ OpenMP loop "
        "(6.08 s Stage-1"
    )
    lines.append(
        "   at 32 threads) with `printf` + `fflush(stdout)` inside `#pragma omp parallel for`; "
        "switching to"
    )
    lines.append(
        "   FWHT ($O(H \\log_2 H \\cdot N_{\\text{WFS}})$) or `cublasSgemm` removes >99% "
        "of ops."
    )
    lines.append(
        f"4. **Consolidate CUDA context memory ({len(gpu_procs)} GPU daemons = "
        f"{gpu_vram_sum_gib:.2f} GiB VRAM)**:"
    )
    lines.append(
        "   Separate `cacaosim` and `MVMextract` OS processes each allocate ~560-820 MiB CUDA "
        "primary context"
    )
    lines.append(
        "   for `<0.2 GiB` of live arrays. Fusing optics via `htsim` + CUDA MPS cuts VRAM by >75%."
    )
    lines.append(
        f"5. **Pin processes to GPU-local NUMA Node 0 "
        f"(`{h.get('numa_node0_cpus', '0-127,256-383')}`)**:"
    )
    lines.append(
        f"   Tracked daemons averaged **{avg_numa1_pct:.0f}%** remote NUMA-1 thread residency, "
        "traversing"
    )
    lines.append("   xGMI Infinity Fabric to reach the Node-0 RTX PRO 6000.")
    lines.append(
        "6. **Make `mfilt` post-`selfRM` FITS save async & OpenMP-parallelize "
        "`maskextrapolate.c`**:"
    )
    lines.append(
        "   Synchronous disk FITS writes stall closed-loop ticks at `selfRM` completion; native C"
    )
    lines.append(
        "   `cacaosim.wfstat` already eliminated Python SHM polling."
    )
    lines.append("")
    lines.append("### B. Recommended Features & Programs for `milk`, `cacao`, and `cacaosim`")
    lines.append(
        "- **`milk`**: (1) Provide generic C `milk-fpsexec-mem-streamstat` (zero-copy pupil-"
        "masked RMS +"
    )
    lines.append(
        "  FITS cube sampler, modeled on `cacaosim.wfstat`); (2) `.procinfo.numanode`, "
        "`.procinfo.OMPwait`,"
    )
    lines.append(
        "  and `OMP_WAIT_POLICY=PASSIVE` defaults added in `libcomputeunit` + `fpspipe`; add "
        "rootless"
    )
    lines.append(
        "  core-slice partitioning across workers; (3) add `--cuda-host-register` in "
        "`ImageStreamIO`"
    )
    lines.append(
        "  + `MVMextract` for pinned H2D/D2H transfers; (4) target Bash >= 5.3 (`${| ...; }`) "
        "so `@get`/`@set`"
    )
    lines.append(
        "  avoid subshell forks; (5) standardize `milk-sysmon` + `milk-perf-report` in CI/bench "
        "runs."
    )
    lines.append(
        "- **`cacao`**: (1) Convert `generateRMWFS` and `aolHaddec` C code to `cublasSgemm` / "
        "FWHT and remove"
    )
    lines.append(
        "  `printf`/`fflush` from OpenMP loops; (2) add async/skip-disk-save option for `mfilt` "
        "during `selfRM`;"
    )
    lines.append(
        "  (3) export structured `calib_timings.json` natively from `cacaocc` calibration runs."
    )
    lines.append(
        "- **`cacaosim`**: (1) Add optional intermediate pupil-beam SHM export and built-in "
        "`wfstat` OPD"
    )
    lines.append(
        "  variance accumulators to `cacaosim.htsim` (extending its existing multi-rate `navg` "
        "CUDA Graph);"
    )
    lines.append(
        "  (2) offload `csim_vis_pickoff`, `csim_dichroic`, and `csim_dm` CPU relays to GPU "
        "when CUDA-enabled;"
    )
    lines.append(
        "  (3) keep `cacaosim.wfstat` + `cacaosim-ao-report` as standard end-to-end "
        "verification tools."
    )
    lines.append("")

    rep_path = os.path.join(out_dir, "COMPUTE_REPORT.md")
    with open(rep_path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    return {
        "total_shm_mb": total_shm_mb,
        "total_shm_bw_mb_s": total_shm_bw,
        "subsystems": subsys,
        "report_md": rep_path,
    }


def main():
    mono = check_help_early(sys.argv[1:])
    ap = argparse.ArgumentParser(
        prog="milk-perf-report",
        description=DESC_ONE,
    )
    ap.add_argument("-t", "--telemetry", required=True, help="compute_telemetry.json path")
    ap.add_argument("-c", "--csv", default="", help="compute_timeseries.csv path")
    ap.add_argument("-o", "--outdir", default="", help="Output directory")
    ap.add_argument("--ao-metrics", default="", help="Optional ao3k_scexao_metrics.json path")
    ap.add_argument("--calib-stg1", default="", help="Optional Stage-1 calib_timings.json")
    ap.add_argument("--calib-stg2", default="", help="Optional Stage-2 calib_timings.json")
    ap.add_argument("--microbench", default="", help="Optional cacaosim-benchmark output text")
    ap.add_argument("--compare-modes", default="", help="Optional modular vs fused JSON")
    ap.add_argument("--ablation", default="", help="Optional suggestion1_ablation.json")
    ap.add_argument("-hm", "--help-mono", action="store_true", help="Monochrome help")
    args = ap.parse_args()
    _ = mono

    out_dir = args.outdir or os.path.dirname(os.path.abspath(args.telemetry)) or "."
    os.makedirs(out_dir, exist_ok=True)

    telem = load_opt_json(args.telemetry)
    if not telem:
        sys.exit(f"milk-perf-report: cannot load telemetry JSON '{args.telemetry}'")

    csv_path = args.csv or os.path.join(os.path.dirname(args.telemetry), "compute_timeseries.csv")
    ts_rows = load_csv(csv_path)
    ao_metrics = load_opt_json(args.ao_metrics)
    c_stg1 = load_opt_json(args.calib_stg1)
    c_stg2 = load_opt_json(args.calib_stg2)
    c_stgs = [c_stg1, c_stg2]
    micro_rows = parse_microbench(args.microbench)
    compare = load_opt_json(args.compare_modes)
    abl_path = args.ablation or os.path.join(out_dir, "suggestion1_ablation.json")
    ablation = load_opt_json(abl_path)

    procs = dedup_processes(telem.get("processes", []))
    cl_procs = [p for p in procs if p.get("cl_cpu_s", 0.0) > 0.0 or p.get("cl_loopcnt", 0) > 0]
    if not cl_procs:
        cl_procs = procs
    streams = telem.get("streams", [])

    render_plots(out_dir, telem, ts_rows, procs, cl_procs, streams, c_stgs, micro_rows, compare)
    extra = compile_markdown(
        out_dir,
        telem,
        ts_rows,
        procs,
        cl_procs,
        streams,
        c_stgs,
        micro_rows,
        compare,
        ao_metrics,
        ablation,
    )

    perf_out = {
        "host": telem.get("host", {}),
        "gpu": telem.get("gpu", {}),
        "run": telem.get("run", {}),
        "phases": telem.get("phases", []),
        "summary": extra,
        "microbenchmarks": micro_rows,
        "calib_stage1": c_stg1,
        "calib_stage2": c_stg2,
        "modular_vs_fused": compare,
        "suggestion1_ablation": ablation,
    }
    pjson = os.path.join(out_dir, "compute_perf_metrics.json")
    with open(pjson, "w", encoding="utf-8") as fh:
        json.dump(perf_out, fh, indent=2)
        fh.write("\n")

    print(f"[milk-perf-report] Wrote {extra['report_md']} and 3 compute figures.")


if __name__ == "__main__":
    main()
