def compile_markdown(
    out_dir,
    telem,
    ts_rows,
    procs,
    cl_procs,
    streams,
    c_stgs,
    micro_rows,
    compare,
    ao_metrics,
    ablation=None,
):
    h = telem.get("host", {})
    g = telem.get("gpu", {})
    run = telem.get("run", {})
    phases = telem.get("phases", [])
    ov = next((p for p in phases if p.get("id") == "overall"), {})
    cl_ph = next(
        (p for p in phases if "closed_loop" in p.get("id", "") and "warmup" not in p["id"]),
        {},
    )
    cl_dur = max(run.get("closed_loop_duration_s", 1.0), 0.1)

    total_shm_mb = sum(s.get("frame_bytes", 0) for s in streams) / (1024.0 * 1024.0)
    total_shm_bw = sum(s.get("mean_mb_s", 0.0) for s in streams)
    subsys = {}
    for p in cl_procs:
        sub = classify_process(p["name"], p.get("cmdline", ""))
        subsys.setdefault(sub, {"procs": 0, "cpu_s": 0.0, "vram": 0.0})
        subsys[sub]["procs"] += 1
        subsys[sub]["cpu_s"] += p.get("cl_cpu_s", 0.0)
        subsys[sub]["vram"] += p.get("gpu_vram_peak_mib", 0.0)
    gpu_procs = [p for p in cl_procs if p.get("gpu_vram_peak_mib", 0.0) > 1.0]
    gpu_vram_sum_gib = sum(p.get("gpu_vram_peak_mib", 0.0) for p in gpu_procs) / 1024.0
    numa_procs = [
        p
        for p in cl_procs
        if (p.get("numa0_hits", 0) + p.get("numa1_hits", 0)) > 0
        and classify_process(p["name"], p.get("cmdline", "")) != "Orchestration"
    ]
    avg_numa1_pct = (
        sum(p.get("numa_remote_pct", 0.0) for p in numa_procs) / len(numa_procs)
        if numa_procs
        else 0.0
    )

    lines = []
    lines.append("# Compute Performance & Optimization Report: Subaru AO3k + SCExAO Simulation")
    lines.append("")
    lines.append(
        "Standalone systems profiling report covering CPU, NUMA, GPU, `PROCESSINFO` real-time "
        "latency,"
    )
    lines.append(
        "`ImageStreamIO` shared-memory bandwidth, calibration costs, and concrete optimization "
        "paths"
    )
    lines.append(
        "measured with native `milk` (`milk-sysmon`, `milk-perf-report`, `fpspipe`, `sysmon`) "
        "and `cacaosim`"
    )
    lines.append("(`cacaosim.wfstat`, `cacaosim-benchmark`) tools.")
    lines.append("")
    lines.append("> Companion optical report: [REPORT.md](REPORT.md)")
    lines.append("")

    # 1. Executive Compute Summary
    lines.append("## 1. Executive Compute Summary & Hardware Topology")
    lines.append("")
    lines.append("| Subsystem / Metric | Measured Value |")
    lines.append("| :--- | :--- |")
    lines.append(f"| Host / Kernel | `{h.get('hostname', 'N/A')}` / `{h.get('kernel', 'N/A')}` |")
    lines.append(
        f"| CPU Architecture | {h.get('cpu_model', 'N/A')} ({h.get('nb_cpus', 0)} logical CPUs, "
        f"{h.get('nb_numa_nodes', 1)} NUMA nodes) |"
    )
    lines.append(
        f"| CPU Governor / Max Boost | `{h.get('scaling_governor', 'N/A')}` "
        f"(max {h.get('cpu_max_mhz', 0):.0f} MHz) |"
    )
    lines.append(
        f"| System RAM / `/dev/shm` | {h.get('ram_total_mb', 0)/1024:.0f} GiB RAM / "
        f"{h.get('shm_total_mb', 0)/1024:.0f} GiB SHM |"
    )
    if g.get("present"):
        lines.append(
            f"| GPU & Driver | {g.get('name', 'N/A')} (Driver {g.get('driver', '')}, "
            f"{g.get('vram_total_mib', 0)/1024:.1f} GiB VRAM, "
            f"{g.get('power_limit_w', 0):.0f} W cap) |"
        )
        lines.append(
            f"| GPU PCIe & NUMA Affinity | Bus `{g.get('pci_bus_id', '')}`, PCIe "
            f"Gen{g.get('pcie_gen', 0)} x{g.get('pcie_width', 0)}, "
            f"NUMA Node {g.get('numa_node', -1)} "
            f"(CPUs `{h.get('numa_node0_cpus', '')}`) |"
        )
    lines.append(
        f"| Shell Engine / Perf Counters | `{h.get('bash_version', '')}` / "
        f"`perf_event_paranoid={h.get('perf_paranoid', 99)}` |"
    )
    ov_sim_mean = ov.get("sim_cores_mean", ov.get("cpu_cores_mean", 0.0))
    ov_sim_peak = ov.get("sim_cores_peak", ov.get("cpu_cores_peak", 0.0))
    cl_sim_mean = cl_ph.get("sim_cores_mean", ov_sim_mean) if cl_ph else ov_sim_mean
    lines.append(
        f"| Overall Wall Duration & Compute | **{run.get('wall_duration_s', 0):.2f} s**; "
        f"AO/Sim mean **{ov_sim_mean:.2f}** (peak {ov_sim_peak:.2f} cores); "
        f"host mean {ov.get('cpu_cores_mean', 0):.2f} (peak {ov.get('cpu_cores_peak', 0):.2f}) |"
    )
    if cl_ph:
        cl_sim_pk = cl_ph.get("sim_cores_peak", cl_ph.get("cpu_cores_peak", 0.0))
        lines.append(
            f"| Closed-Loop Window ({cl_ph.get('duration_s', 0):.2f} s) | "
            f"AO/Sim CPU: **{cl_sim_mean:.2f} cores** (peak {cl_sim_pk:.2f}); "
            f"Host CPU: {cl_ph.get('cpu_cores_mean', 0):.2f} "
            f"({cl_ph.get('cpu_sys_share_pct', 0):.1f}% sys); "
            f"GPU SM: **{cl_ph.get('gpu_util_mean_pct', 0):.1f}%** "
            f"(peak {cl_ph.get('gpu_util_peak_pct', 0):.0f}%); "
            f"VRAM: **{cl_ph.get('gpu_vram_peak_mib', 0)/1024:.2f} GiB**; "
            f"SHM: **{cl_ph.get('shm_bw_mean_mb_s', 0):.1f} MB/s** |"
        )
    if ao_metrics:
        s_a = ao_metrics.get("star_and_atmosphere", {})
        if s_a:
            pt = max(s_a.get("physical_time_s", 1.0), 1e-6)
            we = s_a.get("wall_elapsed_s", cl_dur)
