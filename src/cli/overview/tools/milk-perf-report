    ax.set_title("C. Per-Process GPU VRAM & Cross-Socket NUMA 1 Residency", loc="left")
    ax.grid(True, axis="x", alpha=0.28)

    # Panel D: Context switches per closed-loop iteration
    ax = axess[1, 1]
    ctx_p = [p for p in cl_procs if p.get("cl_loopcnt", 0) >= 50]
    ctx_p = sorted(
        ctx_p,
        key=lambda p: (p.get("cl_vol_ctxt", 0) + p.get("cl_nonvol_ctxt", 0))
        / max(p.get("cl_loopcnt", 1), 1),
        reverse=True,
    )[:15]
    ctx_rev = list(reversed(ctx_p))
    if ctx_rev:
        cnames = [p["name"][:22] for p in ctx_rev]
        vol_it = [p.get("cl_vol_ctxt", 0) / max(p.get("cl_loopcnt", 1), 1) for p in ctx_rev]
        nvl_it = [p.get("cl_nonvol_ctxt", 0) / max(p.get("cl_loopcnt", 1), 1) for p in ctx_rev]
        y = np.arange(len(cnames))
        ax.barh(y, vol_it, color="#0d9488", label="Voluntary / iter")
        ax.barh(y, nvl_it, left=vol_it, color="#f97316", label="Involuntary / iter")
        ax.set_yticks(y)
        ax.set_yticklabels(cnames, fontsize=7.6)
        ax.legend(loc="lower right")
    ax.set_xlabel("Context Switches per Loop Iteration")
    ax.set_title("D. Synchronization & Preemption Overhead (Ctx Switches / Iter)", loc="left")
    ax.grid(True, axis="x", alpha=0.28)

    fig.tight_layout(rect=[0.0, 0.0, 1.0, 0.96])
    fig.savefig(os.path.join(out_dir, "compute_process_breakdown_2x2.png"), dpi=150)
