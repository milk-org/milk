#!/usr/bin/env bash
# milk-setup-caps: Helper script to grant CAP_PERFMON and CAP_SYS_ADMIN to milk-CTRL
# This is required to access hardware performance counters for cache misses and instruction counts.

set -e

TARGET=$(which milk-CTRL 2>/dev/null) || true

if [ -z "$TARGET" ]; then
    echo "Error: milk-CTRL not found in PATH."
    exit 1
fi

echo "Setting capabilities on $TARGET..."

if [ "$EUID" -ne 0 ]; then
  echo "You will be prompted for your sudo password to apply capabilities."
  sudo setcap cap_perfmon,cap_sys_admin+ep "$TARGET"
else
  setcap cap_perfmon,cap_sys_admin+ep "$TARGET"
fi

echo "Capabilities applied successfully."
echo "You can verify them with: getcap $TARGET"
