#!/usr/bin/env bash
# milk-setup-caps: Grant Linux capabilities to milk executables
#
# Capabilities applied:
#   milk-CTRL:          CAP_PERFMON (HW perf counters); CAP_SYS_ADMIN on kernels < 5.8

# Early-exit for -h1 before sourcing
case "${1-}" in
    -h1|--help-oneline)
        echo "grant the perf-counter capability to milk-CTRL"
        exit 0 ;;
esac

MSdescr="grant the perf-counter capability to milk-CTRL"
MSextdescr="Grant milk-CTRL the capability to read hardware performance counters:
  - CAP_PERFMON (Linux 5.8 and later)
  - CAP_SYS_ADMIN on older kernels, which have no CAP_PERFMON
File capabilities are lost when milk-CTRL is reinstalled: run this again after install.
You will be prompted for your sudo password if not running as root."

source milk-script-std-config

RequiredCommands=()
RequiredFiles=()
RequiredDirs=()

MSseealso+=( "milk-CTRL:milk control panel" )
MSseealso+=( "milk-commands:list milk commands with descriptions" )

source milk-argparse

set -e

# Determine the bin directory where milk executables are installed.
# Use the directory of this script as the reference.
BINDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Run setcap, with sudo if needed
run_setcap() {
    local caps="$1"
    local target="$2"

    if [ ! -f "$target" ]; then
        return
    fi

    if [ "$EUID" -ne 0 ]; then
        sudo setcap "$caps" "$target"
    else
        setcap "$caps" "$target"
    fi
}

echo "Setting capabilities on milk executables in ${BINDIR}..."
echo ""

# ── milk-CTRL: hardware performance counters ──
CTRL="${BINDIR}/milk-CTRL"
if [ -f "$CTRL" ]; then
    # CAP_PERFMON exists since Linux 5.8; never grant CAP_SYS_ADMIN where it is enough
    kver=$(uname -r | cut -d- -f1)
    if [ "$(printf '%s\n5.8\n' "$kver" | sort -V | head -1)" = "5.8" ]; then
        caps="cap_perfmon+ep"
    else
        caps="cap_sys_admin+ep"
    fi
    echo "  milk-CTRL: ${caps}"
    run_setcap "$caps" "$CTRL"
else
    echo "  milk-CTRL: not found (skipping)"
fi
