#!/usr/bin/env bash
# milk-setup-caps: Helper script to grant CAP_PERFMON and CAP_SYS_ADMIN to milk-CTRL
# This is required to access hardware performance counters for cache misses and instruction counts.

# Early-exit for -h1 before sourcing
case "${1-}" in
    -h1|--help-oneline)
        echo "grant hardware performance counter capabilities to milk-CTRL"
        exit 0 ;;
esac

MSdescr="grant hardware performance counter capabilities to milk-CTRL"
MSextdescr="Helper script to grant CAP_PERFMON and CAP_SYS_ADMIN to milk-CTRL.
This is required to access hardware performance counters for cache misses and instruction counts.
You will be prompted for your sudo password to apply capabilities if not running as root."

source milk-script-std-config

RequiredCommands=()
RequiredFiles=()
RequiredDirs=()

MSseealso+=( "milk-CTRL:milk control panel" )
MSseealso+=( "milk-commands:list milk commands with descriptions" )

source milk-argparse

set -e

TARGET=$(which milk-CTRL 2>/dev/null) || true

if [ -z "$TARGET" ]; then
    echo "Error: milk-CTRL not found in PATH."
    exit 1
fi

echo "Setting capabilities on $TARGET..."

if [ "$EUID" -ne 0 ]; then
  echo "You will be prompted for your sudo password to apply capabilities."
  sudo setcap cap_perfmon,cap_sys_admin+ep "$TARGET"
else
  setcap cap_perfmon,cap_sys_admin+ep "$TARGET"
fi

echo "Capabilities applied successfully."
echo "You can verify them with: getcap $TARGET"
