#!/usr/bin/env bash
# milk-setup-caps: Grant Linux capabilities to milk executables
#
# Capabilities applied:
#   milk-CTRL:          CAP_PERFMON + CAP_SYS_ADMIN  (HW perf counters)
#   milk-fpsexec-*:     CAP_SYS_NICE                 (RT scheduling)
#   cacao-fpsexec-*:    CAP_SYS_NICE                 (RT scheduling)

# Early-exit for -h1 before sourcing
case "${1-}" in
    -h1|--help-oneline)
        echo "grant capabilities (perf counters, RT priority) to milk executables"
        exit 0 ;;
esac

MSdescr="grant capabilities (perf counters, RT priority) to milk executables"
MSextdescr="Grant Linux capabilities to milk executables:
  - CAP_PERFMON + CAP_SYS_ADMIN on milk-CTRL for hardware performance counters
  - CAP_SYS_NICE on all milk-fpsexec-* and cacao-fpsexec-* for RT scheduling
You will be prompted for your sudo password if not running as root."

source milk-script-std-config

RequiredCommands=()
RequiredFiles=()
RequiredDirs=()

MSseealso+=( "milk-CTRL:milk control panel" )
MSseealso+=( "milk-commands:list milk commands with descriptions" )

source milk-argparse

set -e

# Determine the bin directory where milk executables are installed.
# Use the directory of this script as the reference.
BINDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Run setcap, with sudo if needed
run_setcap() {
    local caps="$1"
    local target="$2"

    if [ ! -f "$target" ]; then
        return
    fi

    if [ "$EUID" -ne 0 ]; then
        sudo setcap "$caps" "$target"
    else
        setcap "$caps" "$target"
    fi
}

echo "Setting capabilities on milk executables in ${BINDIR}..."
echo ""

# ── milk-CTRL: hardware performance counters ──
CTRL="${BINDIR}/milk-CTRL"
if [ -f "$CTRL" ]; then
    echo "  milk-CTRL: cap_perfmon,cap_sys_admin+ep"
    run_setcap "cap_perfmon,cap_sys_admin+ep" "$CTRL"
else
    echo "  milk-CTRL: not found (skipping)"
fi

# ── fpsexec binaries: RT scheduling ──
count=0
for exe in "${BINDIR}"/milk-fpsexec-* "${BINDIR}"/cacao-fpsexec-*; do
    [ -f "$exe" ] || continue
    name="$(basename "$exe")"
    echo "  ${name}: cap_sys_nice+ep"
    run_setcap "cap_sys_nice+ep" "$exe"
    count=$((count + 1))
done

echo ""
if [ "$count" -gt 0 ]; then
    echo "Capabilities applied to ${count} fpsexec executable(s)."
else
    echo "No fpsexec executables found in ${BINDIR}."
fi

echo ""
echo "Verify with:  getcap ${BINDIR}/milk-fpsexec-*"
