MY_CLI_VAR="hello_from_milk"
!echo $MY_CLI_VAR > env_sync_test.tmp
!echo $HOME >> env_sync_test.tmp

read test_line1 < env_sync_test.tmp
if [ "$test_line1" = "hello_from_milk" ]
then
    echo "Outward Env Sync: PASSED"
else
    echo "Outward Env Sync: FAILED ($test_line1)"
    !rm env_sync_test.tmp
    exit 1
fi

!rm env_sync_test.tmp

echo "All tests passed"
exit 0
