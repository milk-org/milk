_cs -= 3
echo $_cs
unset _cs

#DESC: Compound mul-assign
#EXPECT:OK
_cm = 4
_cm *= 3
echo $_cm
unset _cm

#DESC: Compound div-assign
#EXPECT:OK
_cd = 12
_cd /= 4
echo $_cd
unset _cd

